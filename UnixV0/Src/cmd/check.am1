w_10073,dac u_t2
w_10074,lac i u_t1
w_10075,sza
w_10076,jda u_dupcheck
w_10077,idx u_t1
        sza i
        jmp w_10101
w_10100,idx u_t2
        sza
w_10101,jmp w_10074
w_10102,lac u_linode
w_10103,and u_o200000
w_10104,sza i
w_10105,jmp u_iloop
w_10106,dac x_ac
        idx u_licnt
        sza
