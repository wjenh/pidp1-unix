w_10143,dac x_ac
        idx u_blcnt
        lac x_ac
// By hand, betwen's test against d709 and d6400, by h_betw.
w_10144,jda h_betw
w_10147,jmp u_badadr
w_10150,dac u_t5
w_10151,dac x_lnk
