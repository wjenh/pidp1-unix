w_10040,dzm u_blcnt
w_10041,dzm u_curi
// By hand, copyz's clear of usetab, 500 words.
w_10042,law u_usetab
        dac h_p
        law i 0764
        dac h_n
h_z,    dzm i h_p
        idx h_p
        isp h_n                         // -500 counting up
        jmp h_z
u_iloop,idx u_curi
// By hand, the drum's 250 i-numbers, where 1970's had 3400 and more.
w_10046,law i 0372
w_10047,add u_curi
w_10050,sma
w_10051,jmp u_part2
w_10052,lac u_curi
// By hand, iget and copy, the i-node into linode, by h_iget.
w_10053,jda h_iget
w_10060,lac u_linode
w_10061,sma
w_10062,jmp u_iloop
w_10063,dac x_ac
        idx u_icnt
        sza
        jmp s_10063
        lac x_ac
        jmp w_10065
s_10063,lac x_ac
w_10064,lac u_linode
w_10065,and u_o40
w_10066,sza
w_10067,jmp u_iloop
w_10070,law u_linode+01
w_10071,dac u_t1
