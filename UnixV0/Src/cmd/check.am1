w_10312,idx u_t1
        sza
w_10313,jmp w_10307
w_10314,lac i u_nxfblk
w_10315,sza i
w_10316,jmp u_part3
w_10317,dac u_t1
w_10320,jda u_dupcheck
w_10321,lac u_t1
// By hand, dskrd and copy, sys rblk into ldskbuf.
