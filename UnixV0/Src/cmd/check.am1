        dac i 010
w_10237,idx u_t6
        sza
w_10240,jmp w_10233
w_10241,lac u_d1
w_10242,cal 05
w_10243,u_prbuf
w_10244,0000006
w_10245,jmp r_print
u_part2,lac u_icnt
w_10247,jda u_print
w_10250,lac u_d1
w_10251,cal 05
w_10252,u_m3
w_10253,0000004
w_10254,lac u_licnt
