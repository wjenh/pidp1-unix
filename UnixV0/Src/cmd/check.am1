// h_iget -- by hand, iget and copy, which 1970 called in the kernel through sysloc.
// Copies i-node AC's 12 words into linode, read with sys rblk into ldskbuf from block
// 2 + i/5, at word 12 x (i mod 5).
// Entry: AC = the i-number, 1 to 249.
// Exit: AC and IO are clobbered.
// Called via jda.
h_iget, 0
        dap h_igx
        lac h_iget
        lia
        cla
        scl 1s
        div h_d5
        jmp .+1                         // an overflow, which cannot happen
        dio h_p                         // the i-node's place in its block
        add h_d2
        cal SYSRBLK
        u_ldskbuf
        lac h_p
        ral 2s
        dac h_q                         // 4 x the place
        ral 1s
        add h_q
        add h_lbp
        dac h_p
        law u_linode
        dac h_q
        law i 014
        dac h_n
h_ig1,  lac i h_p
        dac i h_q
        idx h_p
        idx h_q
        isp h_n                         // -12 counting up
        jmp h_ig1
h_igx,  jmp .

// h_betw -- by hand, betwen's test against d709 and d6400, which 1970 called in the
// kernel through sysloc.
// A skip return when d709 <= AC <= d6400.
// Entry: AC = a word.
// AC and IO are preserved.
// Called via jda.
h_betw, 0
        dap h_btx
        lac h_betw
        spa                             // a negative word is out of range, -0 too
        jmp h_bt1
        sub u_d709
        spa                             // skip if d709 or more
        jmp h_bt1
        lac h_betw
        sad u_d6400
        jmp h_bt2
        sub u_d6400
        spa                             // skip if past d6400
        jmp h_bt2
h_bt1,  lac h_betw
        jmp h_btx
h_bt2,  idx h_btx
        lac h_betw
h_btx,  jmp .
