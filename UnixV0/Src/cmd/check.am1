        jmp w_10110
s_10106,lac x_ac
w_10107,law u_linode+01
w_10110,dac u_t1
w_10111,law i 07
w_10112,dac u_t2
w_10113,lac i u_t1
w_10114,sza i
w_10115,jmp w_10136
// By hand, dskrd and copy, sys rblk into ldskbuf.
// A block the kernel refuses is passed over, since dupcheck has already called it bad,
// where 1970's dskrd halted.
w_10116,cal SYSRBLK
        u_ldskbuf
        spa
        jmp w_10136
w_10123,dac x_ac
        idx u_indircnt
        sza
        jmp s_10123
