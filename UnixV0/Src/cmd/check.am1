// By hand, the system block into ldskbuf, sys rblk, and the three pointers sysloc gave
// into the kernel's copy pointed at it.
        cla
        cal SYSRBLK
        u_ldskbuf
        law u_ldskbuf
        dac u_nxfblk
        law u_ldskbuf+1
        dac u_nfblks
        law u_ldskbuf+2
