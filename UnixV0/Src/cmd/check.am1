x_ac,   0
x_io,   0
x_t,    0
// By hand, the words of the fixes for sysloc's routines, which the program reached in the
// kernel's space, and for the alss built from a template.
h_d2,   2                               // the first i-node block
h_d5,   5                               // i-nodes in a block
h_lbp,  u_ldskbuf
h_bitp, h_bits
h_p,    0
h_q,    0
h_n,    0
h_bits, 1; 2; 4; 010; 020; 040; 0100; 0200      // 1 shifted left 0 to 15
        0400; 01000; 02000; 04000; 010000; 020000; 040000; 0100000
0100/
        SYSFRAME()
0117/
// By hand, no sysloc.
// The kernel's routines it named are fixed by hand where they are called.
// The free list's three pointers are set at part2, from the system block.
w_10000,
w_10035,dzm u_indircnt
w_10036,dzm u_icnt
