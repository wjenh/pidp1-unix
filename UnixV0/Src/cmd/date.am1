x_ac,   0
x_io,   0
x_t,    0
// By hand, the words of the divide by 216000 below.
h_d54k, 0151360                         // 54000
h_d3,   3
h_tabp, h_tab
h_tab,  0; 0151360; 0322740; 0474320    // 0, 1, 2 and 3 times 54000
h_a,    0                               // the time / 54000
h_r,    0                               // its remainder
h_p,    0
0100/
        SYSFRAME()
0113/
w_10000,cal 017
w_10001,dzm x_lnk
// By hand, 216000 is past 0377777, and the PDP-1's div takes its divisor signed, where
// the PDP-7's EAE took it unsigned.
// So the time is divided by 54000, then by 4, and the remainder made up again as
// (a mod 4) x 54000 + r, under 216000.
// A year's time divided by 54000 cannot overflow (its high part, doubled, is under 15000).
w_10002,scl 1s
        div h_d54k
        jmp .+1                         // an overflow, which cannot happen
        dio h_r
        dac h_a
        and h_d3
        add h_tabp
        dac h_p
        lac h_a
        sar 2s
        lia                             // the hours, in IO
        lac i h_p
        add h_r                         // the sixtieths past the hour, in AC
        jmp w_10004
w_10003,0645700
w_10004,dac u_sixtieth
