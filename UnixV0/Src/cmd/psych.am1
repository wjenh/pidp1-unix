u__pbp,
        table 01, 0
u__pbp1,0000000
// by hand: fop.s, the floating point package, rewritten for the PDP-1 in fop.ac.
// Its routines keep the names the translation calls.
// psych calls neither sfad nor fno, which are left out.
// Its sin is the table's (FOP_TSIN), for the speed.
// The first figure takes 2.3 s, not 16.8.
// The five constants of fop.s that psych.s names follow it, as translated.
#define FOP_NOSFAD
#define FOP_NOFNO
#define FOP_TSIN
#include "fop.ac"
u_fp1,  0000001
w_12136,0200000
w_12137,0000000
u_o400000,0400000
u_o200000,0200000
u_om60, 0777717
u_fpid2,0000001
w_12163,0311037
w_12164,0552421
// by hand: the display for the 340 in place of the GRAPHIC-2's list (psych.s:18-83,
// 247-256).
//
// 1970 grew its list in buf while the display ran it, two end marks always written
// ahead.
// Here the list is the static part, h_lst (the eight pen buttons and the start at the
// center), then the figure, h_fig, segment after segment, each a parameter word into
// vector mode and its vectors, the last of them back to parameter mode, and after the last
// segment a halt.
// h_seg writes a segment's words past the halt first and the halt's word last, so the
// 340, reading the list as it grows, finds either the old halt or a whole segment, never a
// word half the old and half the new.

// The list's words that the program writes.
h_hlt,  parameter halt
h_nxv,  parameter next(vector)
h_btna, h_bt0           // the first button's first word
h_pbta, h_pbt
h_pbt,  0400000         // the buttons' bits, 0 to 7
        0200000
        0100000
        040000
        020000
        010000
        04000
        02000

// Append the segment h_dx, h_dy, fix's integers, to the figure as 340 vectors.
// It is drawn in 2^h_n pieces, the fewest whose lengths in x and y are at most 127, each
// piece the steps between floor(i*h_ax/2^h_n) and the last, so that the pieces add up to
// the segment exactly and keep to its line.
// A segment is under 1001 in x and in y (in, psych.s:237), so 8 pieces at most, 9 words
// with the parameter word.
// Entry: h_dx, h_dy, and h_p, the figure's halt.
// Exit: h_p is the new halt.
// AC and IO are clobbered.
// Called via jda.
h_seg,  0
        dap h_sgx
        lac h_dx
        spa
        cma                     // the length in x, fix's -0 giving +0
        dac h_ax
        lac h_dy
        spa
        cma
        dac h_ay
        dzm h_n
        lac h_one
        dac h_k
        lac h_m7b
        dac h_lim
h_sg1,  lac h_lim               // double the pieces until both lengths fit
        sub h_ax
        spa
        jmp h_sg2               // h_ax above h_lim
        lac h_lim
        sub h_ay
        sma
        jmp h_sg3               // both fit (x - x is +0)
h_sg2,  idx h_n
        lac h_k
        ral 1s
        dac h_k
        lac h_lim
        ral 1s
        dac h_lim
        jmp h_sg1
h_sg3,  lac h_k
        cma
        dac h_k                 // -2^h_n, counted up by isp
        dzm h_cx
        dzm h_cy
        dzm h_px
        dzm h_py
        lac h_p
        dac h_q
h_sg4,  lac h_cy                // the piece in y
        add h_ay
        dac h_cy
        jda h_shr
        dac h_t
        sub h_py                // 0 to 127
        ral 8s
        ior h_vis
        dac h_t2
        lac h_t
        dac h_py
        lac h_dy
        sma
        jmp h_sg5
        lac h_t2
        ior h_dn
        dac h_t2
h_sg5,  lac h_cx                // the piece in x
        add h_ax
        dac h_cx
        jda h_shr
        dac h_t
        sub h_px
        ior h_t2
        dac h_t2
        lac h_t
        dac h_px
        lac h_dx
        sma
        jmp h_sg6
        lac h_t2
        ior h_lf
        dac h_t2
h_sg6,  isp h_k
        jmp h_sg7
        lac h_t2                // the last piece ends vector mode
        ior h_end
        dac h_t2
        idx h_q
        lac h_t2
        dac i h_q
        idx h_q
        lac h_hlt
        dac i h_q               // the new halt
        lac h_nxv
        dac i h_p               // the old halt last, when the segment is whole
        lac h_q
        dac h_p
h_sgx,  jmp .
h_sg7,  idx h_q
        lac h_t2
        dac i h_q
        jmp h_sg4

// AC, not negative, shifted right h_n places.
// Entry: AC = the value, h_n the places.
// Exit: AC = the value shifted.
// AC is the result, IO is clobbered.
// Called via jda.
h_shr,  0
        dap h_shx
        lio h_shr
        lac h_n
h_sh1,  sza i
        jmp h_sh2
        sir 1s
        sub h_one
        jmp h_sh1
h_sh2,  lai
h_shx,  jmp .

// The push buttons, 1970's pbsflgs, in h_pbs, bit n for button n, from word 4's switches
// and the pen's hits on the buttons; and h_pbi, 1970's pbsflgs+1, the buttons at the last
// press.
// The switches SS1 to SS6 are buttons 0 to 5, each held while it is on.
// A pen hit on a button's words is taken, its bit and the time kept, and the button counts
// as held while the last hit is under 8 sixtieths old; the list is redrawn each 32 ms tick,
// so a pen held on a button hits it about every two.
// A hit made while the program was busy waits in word 4 and is taken at the next call.
// A press is a button held now that was not at the last call.
// Has no arguments; sets h_pbs, h_pbi, h_old, h_now, and on a pen hit h_pen and h_tpen.
// AC and IO are clobbered.
// Called via jda.
h_rdpb, 0
        dap h_rpx
        lac 4
        and h_m6
        ral 9s
        ral 3s                  // switches 1 to 6 to buttons 0 to 5
        dac h_pbs
        cal 017                 // sys time, the low word in IO
        dio h_now
        lac 4
        sma
        jmp h_rp5               // no pen hit waiting
        and h_m17
        dac 4                   // taken
        lac 5
        sub h_btna
        spa
        jmp h_rp5               // before the buttons
        sar 2s
        dac h_t                 // four words a button
        sub h_o7                // +0 for the last button, since sub of equals is +0
        sma sza
        jmp h_rp5               // after them
        lac h_t
        add h_pbta
        dap h_rp4
h_rp4,  lac .
        dac h_pen
        lac h_now
        dac h_tpen
h_rp5,  lac h_tpen
        cma
        add h_now               // sixtieths since, +0 when equal
        spa
        jmp h_rp6
        sub h_o7
        sma sza
        jmp h_rp6               // 8 sixtieths or more
        lac h_pbs
        ior h_pen
        dac h_pbs
h_rp6,  lac h_old
        cma
        and h_pbs
        sza i
        jmp h_rp7               // no button newly held
        lac h_pbs
        dac h_pbi
h_rp7,  lac h_pbs
        dac h_old
h_rpx,  jmp .

// The static part, which capt is given.
// It holds the eight buttons on row 4, below the figure's lowest points, 96 apart from
// 127, 1970's buttons 0 to 7, each four words, a parameter word turning the pen on, the
// column, and two words of characters, which the pen hits.
// Then comes the figure's start at the center, 512 and 512 (psych.s's setx and sety), the
// pen off, at scale 0, where a vector's step is one point.
h_lst,  parameter scale(1) intensity(5) next(point)
        y(0d4) next(parameter)
h_bt0,  parameter lpon next(point)
        x(0d127) next(character)
        type340 "FACT-"
        parameter lpon next(point)
        x(0d223) next(character)
        type340 "FACT+"
        parameter lpon next(point)
        x(0d319) next(character)
        type340 "STEP-"
        parameter lpon next(point)
        x(0d415) next(character)
        type340 "STEP+"
        parameter lpon next(point)
        x(0d511) next(character)
        type340 "BIG  "
        parameter lpon next(point)
        x(0d607) next(character)
        type340 "SMALL"
        parameter lpon next(point)
        x(0d703) next(character)
        type340 "TYPE "
        parameter lpon next(point)
        x(0d799) next(character)
        type340 "EXIT "
        parameter scale(0) intensity(6) lpoff next(point)
        y(0d512) next(point)
        x(0d512) next(parameter)
// The figure, at most 100 segments of 9 words, and the halt.
h_fig,  parameter halt
        table 0d900, 0
x_end,
0110/
r_in,   jmp 0
r_capture,jmp 0
r_release,jmp 0
        constants
start 020000
