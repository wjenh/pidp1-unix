// By hand, a.rel, the side words of every word process stores, for as1.
// Words 0 to 5 are the head.
// They are the count of pass 2's errors, the number of files, "..", 4 (the words a
// record), the spans the table could not keep, and 0.
// From word 6 come the files' names, 4 words each, at most 14.
// From word 64 come four words for each word of a.out, at 64 + 4 x its address.
//   Word 0 is flags | the line its statement starts on (12 bits); a line of 0 marks a
//   word never stored.
//   The flags are 0400000 relocatable; 0200000 word 2 holds the base, the value of the
//   expression's one relocatable term, which is not subtracted; 0100000 one term, no
//   operator; 040000 a term subtracted; 020000 a span, a relocatable value less a
//   relocatable one, with words 2 and 3's high six bits its end, the value before the
//   subtraction, and word 3's low twelve its start, the value subtracted; 010000 the
//   first term is a name, with its entry in n.out (its offset from n.out's first word)
//   in word 1's low twelve bits.
//   Word 1 is the file's index (0 the first named), in the high six bits | the name's
//   entry.
//   Word 2 is the span's end, high six bits | the base.
//   Word 3 is the span's end, low six bits | the span's start.
// Every value is unrelocated, a word's place in a.out ("..", 4096, not added).
// The flags are kept in their final bit places as the expression is read (h_stm, h_gr,
// h_gnm, oper, ominus), and the records go through h_rbuf, four at a time.

// h_tad is the PDP-7's tad, AC + h_tb + h_tc, a carry in of 0 or 1, modulo 2^18, as the
// PDP-7 adds its 18-bit words.
// It adds in halves of nine bits, so that the PDP-1's end-around carry and its -0 never
// enter.
// Entry: AC, h_tb, h_tc.
// Exit: AC = the sum.
// IO is preserved.
h_tad,  0
        dap h_tdx
        lac h_tad
        and h_m777
        add h_tc
        dac h_t1
        lac h_tb
        and h_m777
        add h_t1
        dac h_t1                        // the low halves' sum, at most 01777
        lac h_tad
        rar 9s
        and h_m777
        dac h_t2
        lac h_tb
        rar 9s
        and h_m777
        add h_t2
        dac h_t2                        // the high halves' sum
        lac h_t1
        rar 9s
        and u_d1                        // the low halves' carry
        add h_t2
        ral 9s
        and h_mhi
        dac h_t2
        lac h_t1
        and h_m777
        ior h_t2
h_tdx,  jmp .

// h_stm, as a statement starts (assm2, its first character read), keeps its line and
// file, and clears its expression's state for a.rel, one term until an operator (oper).
// Entry: by jsp.
// Exit: AC is clobbered.
// IO is preserved.
h_stm,  dap h_smx
        lac u_lineno
        dac h_lin
        lac h_fno
        dac h_fil
        lac u_d1
        dac h_frst
        law 1
        rar 3s
        dac h_nop
        dzm h_nrl
        dzm h_bset
        dzm h_base
        dzm h_nmf
        dzm h_nam
        dzm h_min
        dzm h_spn
        dzm h_lo
        dzm h_hi
h_smx,  jmp .

// h_gr is grand's return, by jmp, with its term in rand.
// A relocatable term is counted, and kept as the base unless it is subtracted (orator
// 3); the first term has no operator.
// Then grand returns.
h_gr,   lac u_rand
        sad u_d1
        jmp h_gr1
        jmp h_gr3                       // absolute
h_gr1,  idx h_nrl
        lac h_frst
        sza
        jmp h_gr2                       // the first term
        lac u_orator
        sad u_d3
        jmp h_gr3                       // subtracted
h_gr2,  lac u_rand+01
        dac h_base
        law 1
        rar 2s
        dac h_bset
h_gr3,  dzm h_frst
        jmp r_grand

// h_gnm takes a name's term, in grand.
// It keeps the first term's entry in n.out, and a span the name was assigned (h_asg),
// when the expression has none yet.
// Entry: AC = the name's type word, its entry + 4.
// Exit: AC unchanged.
// IO is preserved.
h_gnm,  0
        dap h_gnx
        lac h_frst
        sza i
        jmp h_gn1
        lac h_gnm
        sub h_nl4
        dac h_nam
        law 1
        rar 6s
        dac h_nmf
h_gn1,  lac h_spn
        sza
        jmp h_gn9
        lac h_gnm
        jda h_sfnd
        sza i
        jmp h_gn9                       // no span
        dac h_q
        idx h_q
        lac i h_q
        dac h_lo
        idx h_q
        lac i h_q
        dac h_hi
        law 1
        rar 5s
        dac h_spn
h_gn9,  lac h_gnm
h_gnx,  jmp .

// h_sfnd finds the span table's slot whose first word is AC (a name's type word, or 0
// for a freed slot), up to the table's mark.
// A slot is the key, the span's start and its end.
// Entry: AC = the key.
// Exit: AC = the slot's address, or 0.
// IO is preserved.
h_sfnd, 0
        dap h_sfx
        law h_stab
        dac h_q
        lac h_sn
        sza i
        jmp h_sf0                       // empty
        cma
        dac h_k                         // -slots, counting up
h_sf1,  lac i h_q
        sad h_sfnd
        jmp h_sf2
        lac h_q
        add u_d3
        dac h_q
        isp h_k
        jmp h_sf1
h_sf0,  cla
        jmp h_sfx
h_sf2,  lac h_q
h_sfx,  jmp .

// h_asg handles an assignment, after its expression.
// name = a difference of places keeps its span in the span table, under the name's type
// word (lvrand), so that the name used later carries it (h_gnm), as as7am1 carries a
// span through an assignment; an assignment of anything else frees the name's slot.
// A full table counts the span lost.
// Entry: by jsp.
// Exit: AC is clobbered.
// IO is preserved.
h_asg,  dap h_asx
        lac u_lvrand
        jda h_sfnd
        dac h_q                         // the name's slot, or 0
        lac h_spn
        sza
        jmp h_as1
        lac h_q
        sza i
        jmp h_asx
        dzm i h_q                       // no span, so its slot is freed
        jmp h_asx
h_as1,  lac h_q
        sza
        jmp h_as3                       // its slot
        cla
        jda h_sfnd
        dac h_q
        sza
        jmp h_as3                       // a freed slot
        law HSPANS
        sub h_sn
        sza i
        jmp h_as2                       // full
        lac h_sn
        ral 1s
        add h_sn
        dac h_q
        law h_stab
        add h_q
        dac h_q                         // the next slot
        idx h_sn
        jmp h_as3
h_as2,  idx h_spov
        jmp h_asx
h_as3,  lac u_lvrand
        dac i h_q
        idx h_q
        lac h_lo
        dac i h_q
        idx h_q
        lac h_hi
        dac i h_q
h_asx,  jmp .

// h_rel puts the side words of the word process stores into h_rbuf (the format above),
// the buffer first moved to the word's four if it holds others.
// Entry: h_adr = the word's address in a.out, r its type, the state h_stm cleared and
// grand, h_gnm, oper and ominus set.
// Exit: AC is clobbered.
// IO is preserved.
h_rel,  0
        dap h_rlx
        lac h_adr
        rar 2s
        and h_m7777
        add u_d1                        // its four, 1 + its address / 4
        sad h_rbk
        jmp h_rl1
        jda h_rwr
h_rl1,  lac h_adr
        and u_d3
        ral 2s
        dac h_p
        law h_rbuf
        add h_p
        dac h_p                         // its record
        lac u_r
        sad u_d1
        jmp h_rl2
        cla
        jmp h_rl3
h_rl2,  law 1
        rar 1s                          // relocatable
h_rl3,  ior h_nop
        ior h_min
        ior h_spn
        ior h_nmf
        dac h_w
        lac h_nrl
        sad u_d1
        jmp h_rl4
        jmp h_rl5
h_rl4,  lac h_bset                      // the base, the one relocatable term
        ior h_w
        dac h_w
h_rl5,  lac h_lin
        and h_m7777
        ior h_w
        dac i h_p                       // word 0
        idx h_p
        lac h_fil
        rar 6s
        and h_m77h
        dac h_w
        lac h_nam
        and h_m7777
        ior h_w
        dac i h_p                       // word 1
        idx h_p
        lac h_hi
        ral 6s
        and h_m77h
        dac h_w
        lac h_base
        and h_m7777
        ior h_w
        dac i h_p                       // word 2
        idx h_p
        lac h_hi
        rar 6s
        and h_m77h
        dac h_w
        lac h_lo
        and h_m7777
        ior h_w
        dac i h_p                       // word 3
h_rlx,  jmp .

// h_rwr writes h_rbuf to its four records' place in a.rel, if it holds them, then clears
// it and fills it from the place of the four numbered AC (from 1; 0, none), as process
// fills a.out's buffer, for a word stored again.
// Four records n are at word 64 + 16 x (n - 1) = 16 x (n + 3).
// Entry: AC = the four wanted.
// Exit: h_rbk = it.
// AC is clobbered.
// IO is preserved.
h_rwr,  0
        dap h_rwx
        lac h_rbk
        sza i
        jmp h_rw1                       // none held
        add u_d3
        ral 4s
        dac h_rw2
        lac h_rfo
        cal 07
h_rw2,  0
        0
        lac h_rfo
        cal 05
        h_rbuf
        020
h_rw1,  jda u_copyz
        h_rbuf
        020
        lac h_rwr
        dac h_rbk
        sza i
        jmp h_rwx                       // none wanted
        add u_d3
        ral 4s
        dac h_rw3
        lac h_rfi
        cal 07
h_rw3,  0
        0
        sma i
        jmp h_rwx                       // past the file's end
        lac h_rfi
        cal 04
        h_rbuf
        020
h_rwx,  jmp .

// h_rfin finishes a.rel, at finis.
// It writes the last records, then the head (the format above) at word 0 and the names
// straight from the argument block, and closes a.rel's two descriptors.
// Entry: nothing.
// Exit: AC is clobbered.
// IO is preserved.
h_rfin, 0
        dap h_rfx
        cla
        jda h_rwr
        lac h_nerr
        dac h_rbuf
        lac h_fno
        add u_d1
        dac h_rbuf+01                   // the files assembled
        dac h_k
        lac x_end+01
        dac h_rbuf+02                   // ".."
        law 4
        dac h_rbuf+03
        lac h_spov
        dac h_rbuf+04
        lac h_rfo
        cal 07
        0
        0
        lac h_rfo
        cal 05
        h_rbuf
        6
        law 016
        sub h_k
        sma
        jmp h_rf1
        law 016
        dac h_k                         // at most 14 names
h_rf1,  lac h_k
        ral 2s
        dac h_rf3
        lac 07777
        add u_d4
        add u_d1
        dac h_rf2                       // the first file's name, in the argument block
        lac h_rfo
        cal 05
h_rf2,  0
h_rf3,  0
        lac h_rfo
        cal 011
        lac h_rfi
        cal 011
h_rfx,  jmp .

// a.rel's state, the rest of it at 044-077.
h_hi,   0                               // the span's end
h_ot,   0                               // ominus's operand's type
h_ov,   0                               // and its value
h_adr,  0                               // the word process stores
h_p,    0
h_q,    0
h_w,    0
h_k,    0
h_rfo,  0                               // a.rel to write
h_rfi,  0                               // a.rel to read
h_rbk,  0                               // the four records in h_rbuf, 0 for none
h_fno,  0                               // the file being read, from 0
h_nerr, 0                               // pass 2's errors
h_spov, 0                               // spans the table could not keep
h_sn,   0                               // the span table's slots in use, its mark
h_stab,
        .+HSPANS+HSPANS+HSPANS/         // HSPANS slots of 3 words
