        0
020/
x_lnk,  0       // the link, in its sign
x_ac,   0
x_io,   0
x_t,    0
// by hand: the display's words, from 024
h_lp,   0       // a pen hit on a cell, the word's address, or 0; 1970's dspdata+1
h_pbs,  0       // the push buttons, 1970's pbsflgs, bit n for button n
h_now,  0       // the time's low word, in sixtieths
h_tpen, 0       // when the pen last hit a button
h_pen,  0       // that button's bit
h_btk,  0       // when the blinking cells last changed
h_p,    0       // the cell being looked at
h_k,    0       // the cells left, counted up from minus
h_m1,   0777776 // -1, the end mark try puts under its moves (ttt1.s:340)
h_o7,   7
h_o5,   5       // the words of a button
h_o20,  020     // the words of a cell
h_bper, 0d14    // sixtieths between a blinking cell's changes
h_m6,   077     // sense switches 1 to 6, in word 4
h_m17,  0377777
h_b0,   0400000 // button 0, MOVE
h_cend, parameter lpoff // each cell's last word, the pen off
h_bof,  parameter scale(0) intensity(1) next(point) // a blinking cell, dim
h_cell, u_sbuf+02000 // the word after the last cell
h_bta,  h_bt0   // the buttons' first words
h_btb,  h_bt7
