// by hand: the display for the 340 in place of the GRAPHIC-2's lists (ttt2.s:166-244).
//
// The list is the 64 cells, u_sbuf, which dsboard writes, then the board's lines and the
// two buttons, h_stat, ending in the halt.
// A cell keeps 1970's 16 words, so that the arithmetic from a cell to its words is 1970's.
// They are its intensity into point mode (noblink or blinkpar), x in point mode, y into
// parameter mode, the glyph's 12 words (a parameter word with the pen on or off, then 11
// vectors, the last ending vector mode), and h_cend, the pen off.
// Every cell has the same modes word for word whatever its glyph, so the 340 can run a
// cell that dsboard is rewriting and still find each word in the mode it was written for.
// 1970's blink is the cell's intensity changed between 7 and 1 each h_bper sixtieths, by
// h_rdpb.
// The empty cells' dots are the pen's targets, as 1970's lpenb made them.

// The glyphs, 12 words each, 1970's strokes, a vector longer than 127 in two.
u_ex,   parameter lpoff next(vector)    // ttt2.s:166-177, ex
        right deltax(0d64) up deltay(0d16)
        right deltax(0d64) up deltay(0d16) visible
        right deltax(0d64) up deltay(0d16) visible
        left deltax(0d96)
        right deltax(0d64) down deltay(0d32) visible
        0
        0
        0
        0
        0
w_12453,end
u_oh,   parameter lpoff next(vector)    // ttt2.s:179-191, oh
        right deltax(0d64) up deltay(0d16)
        right deltax(0d96) visible
        right deltax(0d32) up deltay(0d32) visible
        left deltax(0d96) visible
        left deltax(0d32) down deltay(0d32) visible
        0
        0
        0
        0
        0
w_12467,end
u_dot,  parameter lpon next(vector)     // ttt2.s:193-204, dot, the pen's target
        right deltax(0d64) up deltay(0d16)
        right deltax(0d64) up deltay(0d16)
        right deltax(5) visible
        down deltay(5) visible
        left deltax(5) visible
        up deltay(5) visible
        0
        0
        0
        0
        end

// The push buttons, 1970's pbsflgs, read into h_pbs.
// Bit 0 MOVE and bit 7 EXIT come from the pen, held while the last hit on them is under 8
// sixtieths old, and sense switches 1 to 6 are buttons 0 to 5, held while on (1970 took
// any button but 7 to make the move, and 7 to stop).
// A pen hit on a cell's words is left in h_lp, 1970's dspdata+1, for lphit.
// Each h_bper sixtieths the blinking cells change, bright to dim or back.
// Asks the time, as getpb did.
// Has no arguments; sets h_pbs, h_now, h_btk, h_lp, and on a button hit h_pen and h_tpen.
// AC and IO are clobbered.
// Called via jda.
h_rdpb, 0
        dap h_rpx
        lac 4
        and h_m6
        ral 9s
        ral 3s                  // switches 1 to 6 to buttons 0 to 5
        dac h_pbs
        cal 017                 // sys time, the low word in IO
        dio h_now
        lac h_btk
        cma
        add h_now               // sixtieths since the last change
        spa
        jmp h_rb1               // the clock has wrapped
        sub h_bper
        spa
        jmp h_rp0               // not yet
h_rb1,  lac h_now
        dac h_btk
        lac u_sbufp
        dac h_p
        law i 0100
        dac h_k
h_rb2,  lac i h_p               // each cell's first word
        sad u_blinkpar
        jmp h_rb3
        sad h_bof
        jmp h_rb4
        jmp h_rb5
h_rb3,  lac h_bof
        dac i h_p
        jmp h_rb5
h_rb4,  lac u_blinkpar
        dac i h_p
h_rb5,  lac h_p
        add h_o20
        dac h_p
        isp h_k
        jmp h_rb2
h_rp0,  lac 4
        sma
        jmp h_rp5               // no pen hit waiting
        and h_m17
        dac 4                   // taken
        lac 5
        sub u_sbufp
        spa
        jmp h_rp1               // before the cells
        lac 5
        sub h_cell
        sma
        jmp h_rp1               // after them (x - x is +0)
        lac 5
        dac h_lp                // a cell's word, for lphit
        jmp h_rp5
h_rp1,  lac 5
        sub h_bta
        spa
        jmp h_rp2
        sub h_o5
        sma
        jmp h_rp2
        lac h_b0                // MOVE, button 0
        jmp h_rp3
h_rp2,  lac 5
        sub h_btb
        spa
        jmp h_rp5
        sub h_o5
        sma
        jmp h_rp5
        lac u_o2000             // EXIT, button 7
h_rp3,  dac h_pen
        lac h_now
        dac h_tpen
h_rp5,  lac h_tpen
        cma
        add h_now               // sixtieths since, +0 when equal
        spa
        jmp h_rpx
        sub h_o7
        sma sza
        jmp h_rpx               // 8 sixtieths or more
        lac h_pbs
        ior h_pen
        dac h_pbs
h_rpx,  jmp .

// sbuf-1, which blk1 and blk2 name before the first move (ttt1.s:13, 222).
// dsboard and lphit write noblink and blinkpar into it.
// Not in the list.
w_12546,0

// The cells (ttt2.s:245, 1050 words there, 1024 and 1970's end mark).
u_sbuf,
        .+02000/

// The board's lines and the buttons, after the cells.
// The lines are 1970's dbuf (ttt2.s:205-244), four planes, each from its corner at x 0 and
// y 0, 256, 512 or 768, 768 to the right, 255 and 252 up, 767 back and 256 and 252 down
// to the corner, in vectors of at most 127.
// Then come the buttons, MOVE and EXIT, pen-sensitive texts in the corner to the right of
// the lowest plane, each five words, which h_rdpb reads; and the halt.
h_stat, parameter scale(0) intensity(4) next(point)
        y(0) next(point)
        x(0) next(vector)
        right deltax(0d96) visible
        right deltax(0d96) visible
        right deltax(0d96) visible
        right deltax(0d96) visible
        right deltax(0d96) visible
        right deltax(0d96) visible
        right deltax(0d96) visible
        right deltax(0d96) visible
        right deltax(0d85) up deltay(0d84) visible
        right deltax(0d85) up deltay(0d84) visible
        right deltax(0d85) up deltay(0d84) visible
        left deltax(0d96) visible
        left deltax(0d96) visible
        left deltax(0d96) visible
        left deltax(0d96) visible
        left deltax(0d96) visible
        left deltax(0d96) visible
        left deltax(0d96) visible
        left deltax(0d95) visible
        left deltax(0d85) down deltay(0d84) visible
        left deltax(0d85) down deltay(0d84) visible
        left deltax(0d86) down deltay(0d84) visible end
        parameter next(point)
        y(0d256) next(point)
        x(0) next(vector)
        right deltax(0d96) visible
        right deltax(0d96) visible
        right deltax(0d96) visible
        right deltax(0d96) visible
        right deltax(0d96) visible
        right deltax(0d96) visible
        right deltax(0d96) visible
        right deltax(0d96) visible
        right deltax(0d85) up deltay(0d84) visible
        right deltax(0d85) up deltay(0d84) visible
        right deltax(0d85) up deltay(0d84) visible
        left deltax(0d96) visible
        left deltax(0d96) visible
        left deltax(0d96) visible
        left deltax(0d96) visible
        left deltax(0d96) visible
        left deltax(0d96) visible
        left deltax(0d96) visible
        left deltax(0d95) visible
        left deltax(0d85) down deltay(0d84) visible
        left deltax(0d85) down deltay(0d84) visible
        left deltax(0d86) down deltay(0d84) visible end
        parameter next(point)
        y(0d512) next(point)
        x(0) next(vector)
        right deltax(0d96) visible
        right deltax(0d96) visible
        right deltax(0d96) visible
        right deltax(0d96) visible
        right deltax(0d96) visible
        right deltax(0d96) visible
        right deltax(0d96) visible
        right deltax(0d96) visible
        right deltax(0d85) up deltay(0d84) visible
        right deltax(0d85) up deltay(0d84) visible
        right deltax(0d85) up deltay(0d84) visible
        left deltax(0d96) visible
        left deltax(0d96) visible
