020/
x_lnk,  0       // the link, in its sign
x_ac,   0
x_io,   0
x_t,    0
// By hand, the top of the process bank, where db.s:27 took 017777, the PDP-7 user's
// top.
// The name list is read from nlbuff to there.
h_top,  07777
// h_ty -- by hand, print's call through type (db.s:282, below), an indirect jms on the
// PDP-7.
// The PDP-1's jda has no indirect form.
// prsym is a jda routine and is called by h_ty4's jda.
// proct (prdec) and prasc are reached only through type, so the translator left them
// PDP-7 routines that return by an indirect jump through their first word.
// That word gets the return, as the PDP-7's jms put it there, and the routine is
// entered at its second word with AC the word to print.
// None of the three skips on return.
// Entered by jmp from w_10367 with AC the word to print; leaves by jmp to w_10370.
// AC and IO are not preserved.
h_w,    0                               // the word to print, kept
h_ps,   u_prsym                         // the jda routine among those type names
h_rt,   w_10370                         // the return, past the call
h_ty,   dac h_w
        lac u_type
        sad h_ps
        jmp h_ty3
        dap h_ty1
        dap h_ty2
        idx h_ty2                       // the routine's second word
        lac h_rt
h_ty1,  dac 0
        lac h_w
h_ty2,  jmp 0
h_ty3,  dap h_ty4
        lac h_w
h_ty4,  jda 0
        jmp w_10370
0100/
        SYSFRAME()
0134/
