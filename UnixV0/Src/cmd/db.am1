// Translated by as7am1 from the PDP-7 source cmd/db.s
// for a process bank.
// Word 0 holds the jump to the start, 020-077 the translator's words, 0100-0107 the
// system call frame, the routines' returns and the constants from 0110 (laid down at
// the end), then the program.
// 23-Nov-2026, Claude: 1970 source quotes removed and comments cleaned for the release.
#include "unixsys.ah"
        octal
        bank 2
0/
        jmp w_10000
        0
        0
        0
