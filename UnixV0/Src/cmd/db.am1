// By hand, db on PDP-1 code.
// Every program on the drum is PDP-1 code but an a.out that as1 has not yet seen.
// db reads that one as 1970's db did (PDP-7 code), and every other file in PDP-1 mode.
// In PDP-1 mode relocval is 0, so an address is the file's offset, and the address
// masks are the PDP-1's 07777 (h_am, h_om).
// prsym names a word by the PDP-1's opcodes from the table h_tab, never from n.out
// (h_p1), and a typed name is looked up in the table before n.out (h_gs).
// These words sit after the program, ahead of the name list, since 024-077 cannot hold
// them.
h_p7,   0                               // 1 when the file is PDP-7 code
h_am,   07777                           // the address mask, 017777 for PDP-7 code
h_om,   07777                           // octala's mask, 037777 for PDP-7 code

// h_md -- set the mode, from u_start, before n.out is read over the shell's arguments.
// The file is PDP-7 code when it is named a.out and a.rel's head word 2, as's final
// "..", is 4096 (as1's test, as1.am1).
// Then db.s:25 goes on.
// Entered by jmp from u_start; leaves by jmp to w_10021 with AC = nlbufp.
// AC and IO are clobbered.
h_md,   lac u_rcorep                    // the file's name, "a.out" in three words
        dac h_fq
        law h_aout
        dac h_fv
        law i 3
        dac h_fc
h_md1,  lac i h_fq
        sas i h_fv
        jmp h_md9                       // not a.out, so PDP-1 code
        idx h_fq
        idx h_fv
        isp h_fc
        jmp h_md1
        cal 03                          // sys open; a.rel; 0
        h_arel
        0
        spa
        jmp h_md9                       // no a.rel, so PDP-1 code
        dac h_fc
        cal 04                          // sys read; inbuf; 3, the head's first words
        u_inbuf
        3
        lac h_fc
        cal 011                         // sys close
        lac u_inbuf+2                   // still 0 if the read came short
        sas u_o10000
        jmp h_md9                       // ".." not 4096 (0 in a B program), so PDP-1 code
        lac u_d1
        dac h_p7
        lac u_o17777
        dac h_am
        lac u_o37777
        dac h_om
h_md9,  lac u_nlbufp
        jmp w_10021

// h_dd -- db.s:67, the search for "..", which sets relocval.
// In PDP-1 mode relocval is 0 whatever ".." says (an as1 program's n.out keeps 4096).
// Entered by jmp from w_10074; leaves by jmp to w_10075 with AC the address of dotdot
// for PDP-7 code, else by jmp to mloop.
// AC is not preserved, IO is preserved.
h_dd,   lac h_p7
        sza i
        jmp h_dd1
        law u_dotdot
        jmp w_10075
h_dd1,  dzm u_relocval
        dzm u_mrelocv
        jmp u_mloop

// h_gs -- db.s:585, a typed name not ".".
// In PDP-1 mode the table is searched first, its two words of name against symbuf's
// first two, for an absolute value; then n.out, as 1970's db searched it.
// A name longer than three characters matches no entry, since symbuf holds no space
// before the name's end.
// Entered by jmp from w_10772.
// Found, it sets value, and reloc to 0, and leaves by jmp to getsym's return.
// Otherwise it leaves by jmp to w_10773 with AC the address of symbuf.
// AC is not preserved, IO is preserved.
h_gs,   lac h_p7
        sza
        jmp h_gs9
        law h_tab
        dac h_fq
h_gs1,  lac h_fq
        sad h_tep
        jmp h_gs9                       // not in the table
        dac h_fv
        lac i h_fv
        sas u_symbuf
        jmp h_gs2
        idx h_fv
        lac i h_fv
        sas u_symbuf+1
        jmp h_gs2
        idx h_fv
        lac i h_fv
        dac u_value
        dzm u_reloc
        jmp r_getsym
h_gs2,  lac h_fq
        add u_d3
        dac h_fq
        jmp h_gs1
h_gs9,  law u_symbuf
        jmp w_10773

// h_p1 -- prsym, from db.s:687, with u_word the word.
// PDP-7 code goes on in 1970's prsym, at w_11116 with AC the word.
// In PDP-1 mode the word is named by the PDP-1's instruction classes.
// Each path ends at prsym's return, r_prsym, as 1970's do.
// Entered by jmp from w_11115.
// AC and IO are clobbered.
h_p1,   dzm u_nsearch
        lac h_p7
        sza i
        jmp h_p2
        lac u_word
        jmp w_11116
h_p2,   lac u_word
        and h_m77
        sad h_c016
        jmp h_pcal                      // cal, no indirect bit, so sys
        and u_o760000
        sad u_o640000
        jmp h_pskp
        sad h_c066
        jmp h_psh
        sad u_o700000
        jmp h_plaw
        sad h_c072
        jmp h_piot
        sad u_o760000
        jmp h_popr
// A memory instruction prints as its name, i, and its address as 1970's symadr names it.
// jda's opcode holds the indirect bit, so the opcode with the bit is looked up first.
        dzm h_ind
        law h_dmem
        dac h_fd
        lac u_word
        and h_m77
        jda h_fx
        jmp h_pm1
        jmp h_pm2
h_pm1,  lac u_word
        and u_o10000
        dac h_ind
        lac u_word
        and u_o760000
        jda h_fx
        jmp u_poct                      // not in the table, so the word in octal
h_pm2,  jda h_wn
        lac h_ind
        sza i
        jmp u_symadr
        lac u_o151040                   // "i "
        jda u_wchar
        jmp u_symadr

// sys and the call's name from n.out's absolute names, as 1970's pcal; else its number.
h_pcal, law u_syss
        jda h_wn
        lac u_word
        and h_am
        jda u_nlsearch                  // relflg and relocflg 0, so an exact absolute name
        jmp h_pc1
        jmp h_pnm
h_pc1,  lac u_word
        and h_am
        jmp h_poc

// A skip prints as the names of its bits, skp when it has none.
// Each exact name in the table is one bit's, or skp's with none, so naming the bits
// gives every word the name an exact lookup would.
h_pskp, law h_dskb
        dac h_fd
        law h_tskp
        jmp h_bits

// An operate word prints as nop for 0760000, the table's first name for it.
// Any other prints as its bits' names, opr when it has none.
// The other exact names are one bit's, or lat's and swp's, which the bits name first.
h_popr, lac u_word
        sad u_o760000
        jmp h_pop1
        law h_dob
        dac h_fd
        law h_eopr
        jmp h_bits
h_pop1, law h_topr
        jmp h_pnm

// A shift prints as its name, and its count's bits unless they are 0 (the exact name),
// else in octal.
h_psh,  law h_dsh
        dac h_fd
        lac u_word
        and h_m777
        jda h_fx
        jmp u_poct
        jda u_wrname
        lac u_word
        and h_c777
        sza i
        jmp r_prsym
        dac h_bt
        lac u_o40
        jda u_wchar
        lac h_bt
        jmp h_poc

// A law goes to 1970's plaw, which names its address; a law i prints as law i and its
// number.
h_plaw, lac u_word
        and u_o10000
        sza i
        jmp u_plaw
        law u_laws
        jda h_wn
        lac u_o151040                   // "i "
        jda u_wchar
        lac u_word
        and h_am
        jmp h_poc

// An IOT prints as lem or eem, else as iot and the word's low 13 bits.
h_piot, law h_diot
        dac h_fd
        lac u_word
        jda h_fx
        jmp h_pi1
        jmp h_pnm
h_pi1,  law u_iots
        jda h_wn
        lac u_word
        and u_o17777
        jmp h_poc

// The ends, a name at AC or AC in octal (octw's six digits), then prsym's return.
h_pnm,  jda u_wrname
        jmp r_prsym
h_poc,  jda u_octw
        0                               // octw's argument word, which it skips
        jmp r_prsym

// h_bits -- print a skp or opr word with no single name as the names of the bits it
// holds, from the range at h_fd (a pair before the bits it holds), or as AC's entry,
// the class's name, when it holds none.
// Then i, then any bits left, in octal.
// h_fc holds the class's entry until a bit is named, then 0.
// Entered by jmp with AC the class's entry; ends at prsym's return.
// AC and IO are clobbered.
h_bits, dac h_fc
        lac u_word
        and h_am
        dac h_left
        lac i h_fd
        dac h_fq
        idx h_fd
        lac i h_fd
        dac h_fe
h_bt1,  lac h_fq
        sad h_fe
        jmp h_bt5
        add u_d2
        dac h_fv
        lac i h_fv
        and h_am
        dac h_bt                        // the entry's bits
        and h_left
        sas h_bt
        jmp h_bt4                       // not all of them set
        lac h_fc
        sza
        jmp h_bt2                       // the first name, with no space before it
        lac u_o40
        jda u_wchar
h_bt2,  dzm h_fc
        lac h_fq
        jda u_wrname
        lac h_left
        xor h_bt
        dac h_left
h_bt4,  idx h_fv
        dac h_fq
        jmp h_bt1
h_bt5,  lac h_fc
        sza i
        jmp h_bt6
        jda u_wrname
h_bt6,  lac u_word
        and u_o10000
        sza i
        jmp h_bt7
        lac h_spi                       // " i"
        jda u_wchar
h_bt7,  lac h_left
        sza i
        jmp r_prsym
        lac u_o40
        jda u_wchar
        lac h_left
        jmp h_poc

// h_wn -- write the name at AC, then a space.
// AC and IO are clobbered.
// Called via jda.
h_wn,   0
        dap h_wnr
        lac h_wn
        jda u_wrname
        lac u_o40
        jda u_wchar
h_wnr,  jmp 0

// h_fx -- find the first entry in the range at h_fd whose value is AC.
// h_fd holds the address of a pair, the range's first entry's address and the address
// past its last.
// A skip return when found, with AC the entry's address; no skip otherwise.
// AC is not preserved, IO is preserved; h_fd is kept.
// Called via jda.
h_fx,   0                               // the value sought
        dap h_fxr
        lac h_fd
        dac h_fv
        lac i h_fv
        dac h_fq
        idx h_fv
        lac i h_fv
        dac h_fe
h_fx1,  lac h_fq
        sad h_fe
        jmp h_fxr                       // none
        add u_d2
        dac h_fv
        lac i h_fv
        sad h_fx
        jmp h_fx2
        idx h_fv
        dac h_fq
        jmp h_fx1
h_fx2,  idx h_fxr
        lac h_fq
h_fxr,  jmp 0

h_ind,  0                               // the memory instruction's indirect bit
h_fd,   0                               // a range, the address of its pair of bounds
h_fq,   0                               // the entry
h_fe,   0                               // past the range's last entry
h_fv,   0                               // the entry's value word
h_fc,   0
h_bt,   0                               // an entry's bits
h_left, 0                               // the word's bits not yet named
h_m77,  0770000
h_c016, 0160000
h_c066, 0660000
h_c072, 0720000
h_m777, 0777000
h_c777, 0000777
h_spi,  0040151                         // " i"
h_aout, 0141056; 0157165; 0164040       // "a.out"
h_arel, 0141056; 0162145; 0154040; 0040040 // "a.rel"
h_tep,  h_tend
// The ranges of h_tab, each its first entry and the entry past its last.
h_dmem, h_tmem                          // the memory instructions
        h_tskp
h_dskb, h_tskb                          // the skips' bits
h_dsh,  h_tsh                           // the shifts
        h_tlaw
h_diot, h_tiot                          // lem and eem
        h_topr
h_dob,  h_tob                           // the operate bits, a pair before its bits
        h_toth
// The PDP-1's instruction names, 56 entries.
// Each is two words of name in n.out's packing, then the value.
// An exact value takes the first entry with it (nop before opr).
h_tab,
h_tmem, 0141156; 0144040; 0020000       // and
        0151157; 0162040; 0040000       // ior
        0170157; 0162040; 0060000       // xor
        0170143; 0164040; 0100000       // xct
        0143141; 0154040; 0160000       // cal
        0152144; 0141040; 0170000       // jda
        0154141; 0143040; 0200000       // lac
        0154151; 0157040; 0220000       // lio
        0144141; 0143040; 0240000       // dac
        0144141; 0160040; 0260000       // dap
        0144151; 0160040; 0300000       // dip
        0144151; 0157040; 0320000       // dio
        0144172; 0155040; 0340000       // dzm
        0141144; 0144040; 0400000       // add
        0163165; 0142040; 0420000       // sub
        0151144; 0170040; 0440000       // idx
        0151163; 0160040; 0460000       // isp
        0163141; 0144040; 0500000       // sad
        0163141; 0163040; 0520000       // sas
        0155165; 0154040; 0540000       // mul
        0144151; 0166040; 0560000       // div
        0152155; 0160040; 0600000       // jmp
        0152163; 0160040; 0620000       // jsp
h_tskp, 0163153; 0160040; 0640000       // skp
h_tskb, 0163155; 0141040; 0640400       // sma
        0163160; 0141040; 0640200       // spa
        0163172; 0141040; 0640100       // sza
        0163172; 0157040; 0641000       // szo
        0163160; 0151040; 0642000       // spi
h_tsh,  0162141; 0154040; 0661000       // ral
        0162151; 0154040; 0662000       // ril
        0162143; 0154040; 0663000       // rcl
        0163141; 0154040; 0665000       // sal
        0163151; 0154040; 0666000       // sil
        0163143; 0154040; 0667000       // scl
        0162141; 0162040; 0671000       // rar
        0162151; 0162040; 0672000       // rir
        0162143; 0162040; 0673000       // rcr
        0163141; 0162040; 0675000       // sar
        0163151; 0162040; 0676000       // sir
        0163143; 0162040; 0677000       // scr
h_tlaw, 0154141; 0167040; 0700000       // law
h_tiot, 0154145; 0155040; 0720074       // lem
        0145145; 0155040; 0724074       // eem
h_topr, 0156157; 0160040; 0760000       // nop
h_eopr, 0157160; 0162040; 0760000       // opr
h_tob,  0154141; 0164040; 0762200       // lat
        0163167; 0160040; 0760060       // swp
        0143154; 0141040; 0760200       // cla
        0143154; 0151040; 0764000       // cli
        0143155; 0141040; 0761000       // cma
        0150154; 0164040; 0760400       // hlt
        0154151; 0141040; 0760020       // lia
        0154141; 0151040; 0760040       // lai
h_toth, 0151040; 0040040; 0010000       // i
        0163171; 0163040; 0160000       // sys
h_tend,
x_end,
0110/
r_getexp,jmp 0
r_getspec,jmp 0
r_getsym,jmp 0
r_getnum,jmp 0
r_oprand,jmp 0
r_prsym,jmp 0
r_wrname,jmp 0
r_nlsearch,jmp 0
r_rch,  jmp 0
r_wchar,jmp 0
r_octw, jmp 0
        constants
start 020000
