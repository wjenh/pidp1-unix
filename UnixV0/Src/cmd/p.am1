w_10206,sma
w_10207,jmp w_10213
w_10210,cma
        sub [1]
w_10211,add u_d1
w_10212,dac u_ball1+04
w_10213,lac u_righttes
w_10214,add u_ball1+01
w_10215,sma i
w_10216,jmp w_10227
w_10217,jda u_pocketlr
w_10220,jmp w_10327
w_10221,lac u_ball1+03
w_10222,sma i
w_10223,jmp w_10227
w_10224,cma
