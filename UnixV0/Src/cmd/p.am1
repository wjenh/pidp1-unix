w_10241,add u_d1
w_10242,dac u_ball1+04
w_10243,lac u_displist+01
w_10244,add u_d1
w_10245,sma
w_10246,jmp w_10327
w_10247,dac u_displist+02
// by hand: the pair's second ball tested in the list before it is copied.
// In a pocket (p1.s:217-219), or 2048 or more apart in x (h_near's first test, the same
// words), it is passed by, 016 left past it as the five loads of 1970's copy leave it; near
// in x, 016 is set back before it and the copy made as 1970's.
h_pr,   idx 016                 // its sflg
        lac i 016
        spa
        jmp h_pr1               // in a pocket
        idx 016                 // its x
        lac u_ball1+01
        sub i 016               // dx
        add h_d2k
        spa
        jmp h_pr2               // below -2048
        sub h_d4k
        sma
        jmp h_pr2               // 2048 or more
        law i 2
        add 016
        dac 016
        jmp w_10250
h_pr1,  law 4
        add 016
        dac 016
        jmp w_10325
h_pr2,  law 3
        add 016
        dac 016
        jmp w_10325
w_10250,idx 016
        lac i 016
w_10251,dac u_ball2
w_10252,idx 016
        lac i 016
w_10253,dac u_ball2+01
w_10254,idx 016
        lac i 016
w_10255,dac u_ball2+02
w_10256,idx 016
        lac i 016
w_10257,dac u_ball2+03
w_10260,idx 016
        lac i 016
w_10261,dac u_ball2+04
w_10262,lac u_ball2
w_10263,sma i
w_10264,jmp w_10325
// by hand: the squares of the two balls' distances (p1.s:220-245, the EAE's gsm, muls and
// lrss), by h_near, which skips when they are near and leaves 1970's x**2+y**2 in h_q.
w_10265,jsp h_near
w_10320,jmp w_10325
w_10321,jda u_ballball
w_10322,jda u_putball
w_10323,u_ball2
w_10324,u_displist+02
w_10325,idx u_displist+02
        sza
w_10326,jmp h_pr
// by hand: the next ball's block and its word of h_vis.
w_10327,lac h_bp
        add h_bs
        dac h_bp
        idx h_vp
        jda u_putball
w_10330,u_ball1
w_10331,u_displist+01
w_10332,idx u_displist+01
        sza
w_10333,jmp w_10120
// by hand: the stick hidden when it was not drawn this frame (p1.s:258-259, where 1970
// ended its list).
        jsp h_eof
w_10336,jmp u_loop
u_frict,0000000
