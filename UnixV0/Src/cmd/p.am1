        lac u_sin
        jda h_t15
        dac u_displist+05
        lio u_vt1
        lac u_cos
        jda h_t15
        add u_displist+05
        dac u_ball1+04
        lio u_vt2                       // vx2 = T(cos, vp1) - T(sin, vt2)
        lac u_sin
        jda h_t15
        dac u_displist+05
        lio u_vp1
        lac u_cos
        jda h_t15
        sub u_displist+05
        dac u_ball2+03
        lio u_vp1                       // vy2 = T(sin, vp1) + T(cos, vt2)
        lac u_sin
        jda h_t15
        dac u_displist+05
        lio u_vt2
        lac u_cos
        jda h_t15
        add u_displist+05
