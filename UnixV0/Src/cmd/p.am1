w_10341,and u_d1
w_10342,sza
w_10343,jmp r_frict
// by hand: the EAE's muls by frfac, 0774000, unsigned to the PDP-7 and negative to the
// PDP-1's mul, is h_frc; gsm's magnitude is h_mag.
w_10344,lac u_ball1+03
w_10345,jda h_frc
w_10350,dac u_ball1+03
w_10351,lac u_ball1+04
w_10352,jda h_frc
w_10355,dac u_ball1+04
w_10356,jda h_mag
w_10357,dac u_displist+04
w_10360,lac u_ball1+03
