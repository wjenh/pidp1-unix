w_10367,dzm u_ball1+04
w_10370,jmp r_frict
u_ballball,0000000
        dap r_ballball
        lac u_ballball
// by hand: ballball's arithmetic (p2.s:29-178) is the EAE's throughout, so it is written
// again, each step giving what the PDP-7 gave.
// T(a, v) is 1970's EAE product of a and v (gsm on v, muls by a, then llss n), by h_t12
// (n 6), h_t15 (n 3) and h_t16 (n 2), with a in AC and v in IO.
// 1970's subtraction of x by complement, add and complement, which is AC - x in two's
// complement, is a sub.
// q is h_q (h_near); 0300000 less q and 1 (p2.s:30-31) is the multiplicand of sin and cos.
w_10372,lac u_o300000
        sub h_q
        sub u_d1
        dac h_d
w_10377,lac u_ball2+02
        sub u_ball1+02                  // p2.s:34-36
        lio h_d
        jda h_t12
w_10407,dac u_sin
w_10410,lac u_ball2+01
        sub u_ball1+01                  // p2.s:40-42
        lio h_d
        jda h_t12
w_10420,dac u_cos
// the closing velocities, vp = T(cos, vx) + T(sin, vy) (p2.s:48-75)
w_10421,lio u_ball1+03
        lac u_cos
        jda h_t15
w_10430,dac u_displist+05
w_10431,lio u_ball1+04
        lac u_sin
        jda h_t15
w_10440,add u_displist+05
w_10441,dac u_vp1
w_10442,lio u_ball2+03
        lac u_cos
        jda h_t15
w_10451,dac u_displist+05
w_10452,lio u_ball2+04
        lac u_sin
        jda h_t15
w_10461,add u_displist+05
w_10462,dac u_vp2
        sub u_vp1                       // p2.s:76-78
w_10466,sma
w_10467,jmp r_ballball
// the tangential velocities, vt = T(cos, vy) - T(sin, vx) (p2.s:84-114)
w_10470,lio u_ball1+03
        lac u_sin
        jda h_t15
w_10477,dac u_displist+05
w_10500,lio u_ball1+04
        lac u_cos
        jda h_t15
        sub u_displist+05               // p2.s:95-97
w_10512,dac u_vt1
w_10513,lio u_ball2+03
        lac u_sin
        jda h_t15
w_10522,dac u_displist+05
w_10523,lio u_ball2+04
        lac u_cos
        jda h_t15
        sub u_displist+05               // p2.s:111-113
w_10535,dac u_vt2
// x and y again, the closing parts exchanged (p2.s:119-178).
// 1970's complement of the first term, added to the second and complemented, is the first
// term less the second, ~(b + ~a) = a - b.
w_10536,lio u_vt1                       // vx1 = T(cos, vp2) - T(sin, vt1)
        lac u_sin
        jda h_t15
        dac u_displist+05
        lio u_vp2
        lac u_cos
        jda h_t15
        sub u_displist+05
        dac u_ball1+03
