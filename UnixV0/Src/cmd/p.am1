// by hand: 1970's list (p5.s, after ball2), the balls' records, sixteen of bvsize words,
// which getball and putball reach through listpm1, and dump and restore write and read;
// the translation leaves it past the program's end, here.
        .+0120/

// by hand: what the hand fixes call, and the 340's list.
//
// The arithmetic.
// 1970's p computes in two's complement and the EAE's sign and magnitude; these routines
// give the PDP-7's results, its words read as values, from values kept as the PDP-1's
// ones' complement integers.
// Below, |v|' is gsm's magnitude.
// It is v when v >= 0, and -v-1 below, the ones' complement of a two's complement negative
// (F-75, "EAE"; SIMH's pdp18b_cpu.c).

// T(a, v), 1970's EAE product of a and v (gsm on v, muls by a, then llss n).
// The EAE multiplies |a|' in MQ by |v|', the operand, to P, and complements the 36 bits
// when a and v differ in sign; llss n leaves bits 18-n and up in AC.
// So AC is P >> k, k = 18 - n, its low 18 bits, complemented for a negative product, and
// read as a PDP-7 word.
// 1970's muls by a positive constant m, the link clear, is the same with v = m.
// Entry: AC = a, IO = v.
// Exit: AC = T(a, v).
// AC is the result, IO is clobbered.
// Called via jda, at h_t12 (n 6), h_t15 (n 3) or h_t16 (n 2).
h_t12,  0
        dap h_tx
        lac h_s12
        dac h_tsh
        lac h_t12
        jmp h_tc
h_t15,  0
        dap h_tx
        lac h_s15
        dac h_tsh
        lac h_t15
        jmp h_tc
h_t16,  0
        dap h_tx
        lac h_s16
        dac h_tsh
        lac h_t16
h_tc,   dac h_ta
        dio h_tv
        xor h_tv                // the product's sign, negative when a's and v's differ
        dac h_tng
        lac h_ta
        sma
        jmp h_tc1
        cma
        sub u_d1
h_tc1,  dac h_ta                // |a|'
        lac h_tv
        sma
        jmp h_tc2
        cma
        sub u_d1
h_tc2,  dac h_tv                // |v|'
        lac h_ta
        mul h_tv                // 2P over AC:IO, both factors under 2^17
        scr 9s
        xct h_tsh               // P >> k, its low 18 bits in IO
        dio h_ta
        lac h_ta
        lio h_tng
        spi
        cma                     // a negative product, complemented
        spa
        sub u_d1                // a PDP-7 negative word, as its value here
h_tx,   jmp .
h_s12,  scr 4s                  // the shifts past the first 9, k + 1 in all
h_s15,  scr 7s
h_s16,  scr 8s

// lrss n of v.
// The PDP-7 shifts the two's complement word in from its sign, a floor; sar on a ones'
// complement negative rounds toward zero, so a negative v is shifted as
// -(((-v)-1) >> n) - 1.
// Entry: AC = v.
// Exit: AC = floor(v / 2^n).
// AC is the result, IO is preserved.
// Called via jda, at h_fl1, h_fl6 or h_fl8.
h_fl1,  0
        dap h_fx
        lac h_r1
        dac h_fsh
        lac h_fl1
        jmp h_fc
h_fl6,  0
        dap h_fx
        lac h_r6
        dac h_fsh
        lac h_fl6
        jmp h_fc
h_fl8,  0
        dap h_fx
        lac h_r8
        dac h_fsh
        lac h_fl8
h_fc,   sma
        jmp h_fc1
        cma
        sub u_d1
        xct h_fsh
        cma
        sub u_d1
        jmp h_fx
h_fc1,  xct h_fsh
h_fx,   jmp .
h_r1,   sar 1s
h_r6,   sar 6s
h_r8,   sar 8s

// gsm's magnitude, |v|'.
// Entry: AC = v.
// Exit: AC = |v|'.
// AC is the result, IO is preserved.
// Called via jda.
h_mag,  0
        dap h_mgx
        lac h_mag
        sma
        jmp h_mgx
        cma
        sub u_d1
h_mgx,  jmp .

// frict's EAE multiply of v by frfac, the link clear.
// frfac, 0774000, is 2^18 - 2^11, so P >> 18 is m - ceil(m / 128) for m = |v|'.
// With the link clear, the product's sign is v's, and a negative one is complemented.
// Entry: AC = v.
// Exit: AC = the new v.
// AC is the result, IO is clobbered.
// Called via jda.
h_frc,  0
        dap h_frx
        lac h_frc
        sma
        jmp h_fr1
        cma
        sub u_d1
h_fr1,  dac h_w2                // m
        add h_o177
        sar 7s                  // ceil(m / 128)
        cma
        add h_w2
        lio h_frc
        spi
        jmp h_fr2
        jmp h_frx
h_fr2,  cma                     // the complement, -m'-1
        sub u_d1
h_frx,  jmp .

// Two balls near (p1.s:220-245).
// 1970 squared dx = x1 - x2 with muls, AC P >> 18, and went on when that was under 16,
// which is |dx|' under 2048; then added dy's P >> 18, and went on when the sum S was under
// 16 again, leaving after lrss 4 the S and the low word of dy's square that ballball's
// llss 15 makes x**2+y**2 in q.
// That is S << 11 with that word's top 11 bits.
// Entry: ball1 and ball2 hold the two balls.
// Exit: when they are near, q in h_q.
// AC and IO are clobbered.
// Called via jsp; returns to the word after the call when the balls are far apart, and
// skips it when they are near.
h_near, dap h_nx
        lac u_ball1+01
        sub u_ball2+01          // dx
        add h_d2k
        spa
        jmp h_nx                // below -2048
        sub h_d4k
        sma
        jmp h_nx                // 2048 or more
        lac u_ball1+01
        sub u_ball2+01
        jda h_mag
        dac h_w
        mul h_w                 // 2P, under 2^23
        sar 1s
        dac h_hx                // P >> 18
        lac u_ball1+02
        sub u_ball2+02          // dy
        jda h_mag
        dac h_w
        mul h_w
        scr 1s                  // P, its high word in AC, its low in IO
        add h_hx                // S
        dac h_w
        sub h_d16
        sma
        jmp h_nx                // 16 or more
        lac h_w
        scl 9s
        scl 2s                  // S << 11, the low word's top 11 bits after it
        dac h_q
        idx h_nx
h_nx,   jmp .

// The push buttons, 1970's pbsflgs, read into h_pbs.
// Sense switches 1 to 6 are buttons 0 to 5, held while on; and the pen on one of the nine
// texts is held while its last hit is under 8 sixtieths old.
// The texts are LEFT button 0, RIGHT 1, FAST LEFT 0 and 2, FAST RIGHT 1 and 2 (1970's
// button 2 made a turn coarse), HIT 3, TAP 4, DUMP 5, RESTORE 6, EXIT 7.
// Asks the time, as 1970's kernel read the buttons at each tick.
// Has no arguments; sets h_pbs, h_now, and on a pen hit h_pen and h_tpen.
// AC and IO are clobbered.
// Called via jda.
h_rdpb, 0
        dap h_rpx
        lac 4
        and h_m6
        ral 9s
        ral 3s                  // switches 1 to 6 to buttons 0 to 5
        dac h_pbs
        cal 017                 // sys time, the low word in IO
        dio h_now
        lac 4
        sma
        jmp h_rp5               // no pen hit waiting
        and h_m17
        dac 4                   // taken
        lac 5
        sub h_ba0
        spa
        jmp h_rp5               // before the buttons
        law h_btt
        dac h_p
        law h_bbt
        dac h_r
h_rp1,  lac 5
        sub i h_p
        spa
        jmp h_rp2               // before this one's end, so this one
        idx h_p
        idx h_r
        sad h_bbe
        jmp h_rp5               // past the last
        jmp h_rp1
h_rp2,  lac i h_r
        dac h_pen
        lac h_now
        dac h_tpen
h_rp5,  lac h_tpen
        cma
        add h_now               // sixtieths since, +0 when equal
        spa
        jmp h_rpx               // the clock has wrapped
        sub h_o7
        sma sza
        jmp h_rpx               // 8 sixtieths or more
        lac h_pbs
        ior h_pen
        dac h_pbs
h_rpx,  jmp .
h_ba0,  h_bt0                   // the buttons' first word
h_btt,  h_bt1                   // each button's end, the next one's first word
        h_bt2
        h_bt3
        h_bt4
        h_bt5
        h_bt6
        h_bt7
        h_bt8
        h_bt9
h_bbt,  0400000                 // each button's bits, LEFT first
        0200000                 // RIGHT
        0500000                 // FAST LEFT
        0300000                 // FAST RIGHT
        0040000                 // HIT
        0020000                 // TAP
        0010000                 // DUMP
        0004000                 // RESTORE
        0002000                 // EXIT
h_bbe,  h_bbt+011

// The display.
// The list, h_lst, is captured once.
// It holds 1970's outline, the stick's block, the sixteen balls' blocks and the nine
// buttons, then the halt.
// A ball's block keeps its words' modes whatever it shows, so the 340 can run one that is
// being rewritten.
// The block is a parameter word into point mode, y, x into vector mode, and the circle's 64
// vectors, the last ending them; a ball in a pocket keeps its block with the vectors
// invisible.

// The blocks built, every ball hidden (h_vis 0), at the start.
// Has no arguments and no return values.
// AC is clobbered, IO is preserved.
// Called via jsp.
h_init, dap h_inx
        law h_blk
        dac h_p                 // the block
        law h_vis
        dac h_r
        law i 020
        dac h_k                 // sixteen
h_in1,  dzm i h_r
        lac h_bw0
        dac i h_p
        idx h_p
        lac h_ywd
        dac i h_p
        idx h_p
        lac h_xwd
        dac i h_p
        law h_circ
        dac h_w
        law i 0100
        dac h_w2                // sixty-four
h_in2,  idx h_p
        lac i h_w
        and h_nvis              // invisible until the ball is drawn
        dac i h_p
        idx h_w
        isp h_w2
        jmp h_in2
        idx h_p                 // the next block
        idx h_r
        isp h_k
        jmp h_in1
h_inx,  jmp .

// Ball1 drawn in its block, h_bp.
// Its center is a display unit each 64 of its coordinates, as 1970's lrss 6, held 16
// inside the screen so that its circle, of radius 16, stays on it (a ball can pass its
// cushion by a frame's travel, 16 units, before it bounces); the circle starts at its
// right, x + 16, where 1970's moved before drawing.
// Shown if it was hidden.
// Entry: ball1, h_bp and h_vp, its word of h_vis.
// AC is clobbered, IO is preserved.
// Called via jsp.
h_dbl,  dap h_dbx
        lac h_bp
        dac h_p
        idx h_p                 // its y word
        lac u_ball1+02
        sar 6s
        jda h_clmp
        ior h_ywd
        dac i h_p
        idx h_p                 // its x word
        lac u_ball1+01
        sar 6s
        jda h_clmp
        add h_d16
        ior h_xwd
        dac i h_p
        lac i h_vp
        sza
        jmp h_dbx
        jsp h_show
h_dbx,  jmp .

// A coordinate held from 16 to 1007.
// Entry: AC = the coordinate.
// Exit: AC = it, held.
// AC is the result, IO is preserved.
// Called via jda.
h_clmp, 0
        dap h_cmx
        lac h_clmp
        sub h_d16
        sma
        jmp h_cm1
        lac h_d16               // under 16
        jmp h_cmx
h_cm1,  lac h_clmp
        sub h_d1007
        sma sza
        jmp h_cm2
        lac h_clmp              // within
        jmp h_cmx
h_cm2,  lac h_d1007             // over 1007
h_cmx,  jmp .

// A ball in a pocket is not drawn (p1.s:98-100).
// Its block is hidden if it was shown, then on to 1970's 4f.
// Reached by jmp; AC is clobbered, IO is preserved.
h_pkt,  lac i h_vp
        sza
        jsp h_hide
        jmp w_10327

// The ball's circle shown or hidden.
// The visible bit of its block's 64 vectors is set or cleared, and its word of h_vis with
// it.
// Entry: h_bp, the block, and h_vp, its word of h_vis.
// AC is clobbered, IO is preserved.
// Called via jsp, at h_show or h_hide.
h_show, dap h_shx
        lac h_vbit
        jmp h_sh0
h_hide, dap h_shx
        cla
h_sh0,  dac h_w2
        dac i h_vp
        lac h_bp
        add h_d3
        dac h_p                 // its first vector
        law i 0100
        dac h_k
h_sh1,  lac i h_p
        and h_nvis
        ior h_w2
        dac i h_p
        idx h_p
        isp h_k
        jmp h_sh1
h_shx,  jmp .

// The stick (p4.s:8-37).
// It runs from the cue ball's center, 1970's qcos and qsin each lrss 8, cut where it would
// leave the screen (h_clp, y then x), in four visible vectors, three of a quarter and the
// rest, each within the 340's 127.
// Marked drawn for h_eof.
// Entry: ball1, qcos and qsin.
// AC and IO are clobbered.
// Called via jsp.
h_dstk, dap h_dsx
        dac h_skn               // drawn, since AC is the return, not 0
        lac u_ball1+01
        sar 6s
        dac h_sx
        lac u_ball1+02
        sar 6s
        dac h_sy
        lac u_qcos
        jda h_fl8
        dac h_sdx
        lac u_qsin
        jda h_fl8
        dac h_sdy
        lac h_sy                // cut in y
        dac h_cs
        lac h_sdy
        dac h_cd
        lac h_sdx
        dac h_ce
        jsp h_clp
        lac h_cd
        dac h_sdy
        lac h_ce
        dac h_sdx
        lac h_sx                // and in x
        dac h_cs
        lac h_sdx
        dac h_cd
        lac h_sdy
        dac h_ce
        jsp h_clp
        lac h_cd
        dac h_sdx
        lac h_ce
        dac h_sdy
        lac h_sy                // its start
        ior h_ywd
        dac h_sky
        lac h_sx
        ior h_xwd
        dac h_skx
        lac h_sdx               // a quarter, three times
        sar 2s
        dac h_w
        lac h_sdy
        sar 2s
        dac h_w2
        jsp h_vec
        dac h_sk1
        dac h_sk2
        dac h_sk3
        lac h_w                 // and the rest, less three quarters
        add h_w
        add h_w
        cma
        add h_sdx
        dac h_w
        lac h_w2
        add h_w2
        add h_w2
        cma
        add h_sdy
        dac h_w2
        jsp h_vec
        ior u_o400000           // the last ends them
        dac h_sk4
h_dsx,  jmp .

// The stick cut at the screen's edge in one axis.
// It runs from h_cs, h_cd long in that axis and h_ce in the other; a length that would
// pass 0 or 1023 becomes the one that reaches it, and h_ce is scaled with it
// (h_ce f / h_cd, truncated).
// Entry: h_cs, h_cd and h_ce.
// Exit: h_cd and h_ce, cut.
// AC and IO are clobbered.
// Called via jsp.
h_clp,  dap h_clq
        lac h_cs
        add h_cd                // the end
        sma
        jmp h_cp2
        lac h_cs                // below 0, the length to 0
        cma
        jmp h_cp4
h_cp2,  sub h_d1023
        sma sza
        jmp h_cp3
        jmp h_clq               // within
h_cp3,  lac h_d1023             // past 1023, the length to it
        sub h_cs
h_cp4,  dac h_w
        lac h_ce
        mul h_w
        div h_cd
        jmp h_clq               // never, the quotient being no larger than h_ce
        dac h_ce
        lac h_w
        dac h_cd
h_clq,  jmp .

// A visible 340 vector of h_w in x and h_w2 in y, each from -127 to 127.
// Entry: h_w and h_w2.
// Exit: AC = the vector word.
// AC is the result, IO is preserved.
// Called via jsp.
h_vec,  dap h_vcx
        lac h_w
        sma
        jmp h_vc1
        cma
        ior h_left
h_vc1,  dac h_r
        lac h_w2
        sma
        jmp h_vc2
        cma
        ral 8s
        ior h_down
        jmp h_vc3
h_vc2,  ral 8s
h_vc3,  ior h_r
        ior h_vbit
h_vcx,  jmp .

// The frame's end.
// The stick is hidden, its vectors invisible and of no length, when stickcont did not
// draw it (p1.s:258-259).
// Has no arguments and no return values.
// AC is clobbered, IO is preserved.
// Called via jsp.
h_eof,  dap h_efx
        lac h_skn
        sza
        jmp h_efx
        dzm h_sk1
        dzm h_sk2
        dzm h_sk3
        lac u_o400000
        dac h_sk4
h_efx,  jmp .

h_b16,  0200000                 // 2^16
h_bs,   0103                    // a ball's block, 3 words and 64 vectors
h_d3,   3
h_d16,  020
h_d1007,01757
h_d1023,01777
h_d2k,  04000
h_d4k,  010000
h_o177, 0177
h_m6,   077                     // sense switches 1 to 6, in word 4
h_m17,  0377777
h_o7,   7
h_vbit, visible
h_nvis, 0577777                 // all but visible
h_left, left
h_down, down
h_bw0,  parameter next(point)   // a block's first three words
h_ywd,  y(0) next(point)
h_xwd,  x(0) next(vector)
// h_vis, each ball's block shown, not 0, or hidden
h_vis,
        .+020/

// The circle, 1970's (p5.s's circle, its short vectors of one or two units, after the
// first, a move to the right of 16), each a 340 vector, the last ending them.
h_circ,
        right deltax(0) up deltay(2) visible
        right deltax(0) up deltay(2) visible
        left deltax(1) up deltay(1) visible
        right deltax(0) up deltay(2) visible
        left deltax(1) up deltay(1) visible
        left deltax(1) up deltay(1) visible
        left deltax(1) up deltay(1) visible
        left deltax(1) up deltay(1) visible
        left deltax(1) up deltay(1) visible
        left deltax(1) up deltay(1) visible
        left deltax(1) up deltay(1) visible
        left deltax(1) up deltay(1) visible
        left deltax(2) up deltay(0) visible
        left deltax(1) up deltay(1) visible
        left deltax(2) up deltay(0) visible
        left deltax(2) up deltay(0) visible
        left deltax(2) up deltay(0) visible
        left deltax(2) up deltay(0) visible
        left deltax(1) down deltay(1) visible
        left deltax(2) up deltay(0) visible
        left deltax(1) down deltay(1) visible
        left deltax(1) down deltay(1) visible
        left deltax(1) down deltay(1) visible
        left deltax(1) down deltay(1) visible
        left deltax(1) down deltay(1) visible
        left deltax(1) down deltay(1) visible
        left deltax(1) down deltay(1) visible
        left deltax(1) down deltay(1) visible
        right deltax(0) down deltay(2) visible
        left deltax(1) down deltay(1) visible
        right deltax(0) down deltay(2) visible
        right deltax(0) down deltay(2) visible
        right deltax(0) down deltay(2) visible
        right deltax(0) down deltay(2) visible
        right deltax(1) down deltay(1) visible
        right deltax(0) down deltay(2) visible
        right deltax(1) down deltay(1) visible
        right deltax(1) down deltay(1) visible
        right deltax(1) down deltay(1) visible
        right deltax(1) down deltay(1) visible
        right deltax(1) down deltay(1) visible
        right deltax(1) down deltay(1) visible
        right deltax(1) down deltay(1) visible
        right deltax(1) down deltay(1) visible
        right deltax(2) up deltay(0) visible
        right deltax(1) down deltay(1) visible
        right deltax(2) up deltay(0) visible
        right deltax(2) up deltay(0) visible
        right deltax(2) up deltay(0) visible
        right deltax(2) up deltay(0) visible
        right deltax(1) up deltay(1) visible
        right deltax(2) up deltay(0) visible
        right deltax(1) up deltay(1) visible
        right deltax(1) up deltay(1) visible
        right deltax(1) up deltay(1) visible
        right deltax(1) up deltay(1) visible
        right deltax(1) up deltay(1) visible
        right deltax(1) up deltay(1) visible
        right deltax(1) up deltay(1) visible
        right deltax(1) up deltay(1) visible
        right deltax(0) up deltay(2) visible
        right deltax(1) up deltay(1) visible
        right deltax(0) up deltay(2) visible
        right deltax(0) up deltay(2) visible end

// The list.
h_lst,  parameter scale(0) intensity(7) lpoff next(point)
// The outline, 1970's (p5.s's outline, from x 256, y 4).
// It is the rails where the balls' edges stop, x 260 and 763, y 8 and 1015, cut at the
// corners and notched at the sides for the pockets; its long sides are in vectors of at
// most 127.
        y(4) next(point)
        x(0d256) next(vector)
        right deltax(4) up deltay(0d12) visible
        up deltay(0d127) visible
        up deltay(0d127) visible
        up deltay(0d127) visible
        up deltay(0d107) visible
        left deltax(0d8) up deltay(0d8) visible
        right deltax(0d8) up deltay(0d8) visible
        up deltay(0d127) visible
        up deltay(0d127) visible
        up deltay(0d127) visible
        up deltay(0d106) visible
        left deltax(4) up deltay(0d12) visible
        right deltax(0d12) down deltay(4) visible
        right deltax(0d127) visible
        right deltax(0d127) visible
        right deltax(0d127) visible
        right deltax(0d106) visible
        right deltax(0d12) up deltay(4) visible
        left deltax(4) down deltay(0d12) visible
        down deltay(0d127) visible
        down deltay(0d127) visible
        down deltay(0d127) visible
        down deltay(0d106) visible
        right deltax(0d8) down deltay(0d8) visible
        left deltax(0d8) down deltay(0d8) visible
        down deltay(0d127) visible
        down deltay(0d127) visible
        down deltay(0d127) visible
        down deltay(0d107) visible
        right deltax(4) down deltay(0d12) visible
        left deltax(0d12) up deltay(4) visible
        left deltax(0d127) visible
        left deltax(0d127) visible
        left deltax(0d127) visible
        left deltax(0d106) visible
        left deltax(0d12) down deltay(4) visible end
// The stick, its start, then four vectors, hidden by h_eof.
h_stk,  parameter next(point)
h_sky,  y(0) next(point)
h_skx,  x(0) next(vector)
h_sk1,  0
h_sk2,  0
h_sk3,  0
h_sk4,  end
// The balls' blocks, built by h_init.
h_blk,
        .+02060/
// The buttons, pen-sensitive texts in a column to the right of the table.
// h_rdpb finds a hit by the word's address.
        parameter scale(1) intensity(5) next(parameter)
h_bt0,  parameter lpon next(point)
        y(0d920) next(point)
        x(0d800) next(character)
        type340 "LEFT"
h_bt1,  parameter lpon next(point)
        y(0d850) next(point)
        x(0d800) next(character)
        type340 "RIGHT"
h_bt2,  parameter lpon next(point)
        y(0d780) next(point)
        x(0d800) next(character)
        type340 "FAST LEFT"
h_bt3,  parameter lpon next(point)
        y(0d710) next(point)
        x(0d800) next(character)
        type340 "FAST RIGHT"
h_bt4,  parameter lpon next(point)
        y(0d640) next(point)
        x(0d800) next(character)
        type340 "HIT"
h_bt5,  parameter lpon next(point)
        y(0d570) next(point)
        x(0d800) next(character)
        type340 "TAP"
h_bt6,  parameter lpon next(point)
        y(0d500) next(point)
        x(0d800) next(character)
        type340 "DUMP"
h_bt7,  parameter lpon next(point)
        y(0d430) next(point)
        x(0d800) next(character)
        type340 "RESTORE"
h_bt8,  parameter lpon next(point)
        y(0d360) next(point)
        x(0d800) next(character)
        type340 "EXIT"
h_bt9,  parameter lpoff halt
0110/
r_frict,jmp 0
r_ballball,jmp 0
r_dump, jmp 0
r_restore,jmp 0
r_ballinit,jmp 0
r_put,  jmp 0
r_getball,jmp 0
r_putball,jmp 0
r_stickcon,jmp 0
r_rotate,jmp 0
r_pocketlr,jmp 0
r_pockettb,jmp 0
        constants
start 020000
