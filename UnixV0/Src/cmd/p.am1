w_10225,add u_d1
w_10226,dac u_ball1+03
w_10227,lac u_toptest
w_10230,add u_ball1+02
w_10231,sma i
w_10232,jmp w_10243
w_10233,jda u_pockettb
w_10234,jmp w_10327
w_10235,lac u_ball1+04
w_10236,sma i
w_10237,jmp w_10243
w_10240,cma
