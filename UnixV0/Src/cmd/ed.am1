// By hand, ed2.s:180-407, the regular expressions, in PDP-1 code.
// 1970's compile wrote PDP-7 code into compbuf (a link word, a jms to matchar, the
// character), and execute ran it a character at a time, each list of live matches a
// chain of pairs, a jms to a group and a start word, ending in a jump to xchg
// (Thompson's method).
// The method is kept, with PDP-1 words.
// A group is "jda h_mch; c" for a character, "jda h_mbol" for ^, "jda h_meol" for $
// and "jda h_fnd" at the end, and a list entry is "jsp group; start".
// So a group is entered with AC = the address of its entry's start word, which jda
// keeps in the routine's first word.
// Every address is taken from those words with dap only, since jda's and jsp's AC
// carry the bank's bits.
// The character is kept in h_ch, where 1970 kept it in MQ.
// clsure and matclo, for *, are left out, since 1970's compile never reaches them
// (ed2.s:202-203).
// compile --compile the pattern up to the delimiter in delim into compbuf, or keep
// the last pattern's groups when this one is empty.
// A new line in the pattern, or an empty pattern with no last one, goes to error.
// AC and IO are not preserved.
// Called via jda.
u_compile,0000000
        dap r_compile
        law u_compbuf
        dac h_cp
        dzm u_compflg
u_cadvanc,jda u_getsc
        u_tal
        sad u_delim
        jmp u_cdone
        dac u_compflg
        dzm u_lastre
        sad u_o12
        jmp u_error
        sad u_o136
        jmp u_beglin
        sad u_o44
        jmp u_endlin
        dac h_c                         // a character's group (ed2.s:204-206)
        lac h_jmch
        dac i h_cp
        idx h_cp
        lac h_c
        dac i h_cp
        idx h_cp
        jmp u_cadvanc
u_cdone,lac u_compflg
        sza i
        jmp h_cd1
        dac u_lastre
        lac h_jfnd                      // the found group (ed2.s:214-215)
        dac i h_cp
        jmp r_compile
h_cd1,  lac u_lastre
        sza i
        jmp u_error
        jmp r_compile
u_beglin,lac h_jbol                     // ^'s group (ed2.s:227-228)
        dac i h_cp
        idx h_cp
        jmp u_cadvanc
u_endlin,lac h_jeol                     // $'s group (ed2.s:233-234)
        dac i h_cp
        idx h_cp
        jmp u_cadvanc

// execute -- run the compiled pattern over a line.
// Entry: AC = the line's node.
// Exit: a skip return when it matched, with the number of the match's first character
// in fchrno and the number of the character after it in lchrno, both from 1.
// AC and IO are not preserved.
// Called via jda.
u_execute,0000000
        dap r_execute
        lac u_execute
        jda u_gline
        lac u_linep
        dac u_tal1
        dzm u_charno
        dzm u_fchrno
        dzm u_lchrno
        law u_nlist                     // nlist runs first, empty,
        dac h_run                       // and clist is built (ed2.s:271-276)
        law u_clist
        dac h_nb
        lac h_jxc
        dac i h_run
h_ex1,  lac h_run                       // the list to run after the first group,
        dap h_tv                        // and the one to build (ed2.s:286-293)
        lac h_nb
        dac h_np
        jda u_getsc
        u_tal1
        dac h_ch
        idx u_charno
        jsp u_compbuf
u_charno,0000000
h_tv,   jmp .
u_xchg, lac h_ch
        sad u_o12
        jmp r_execute
        lac h_jxc                       // the new list's end (ed2.s:283-284)
        dac i h_np
        lac h_run                       // the lists exchanged (ed2.s:286-291)
        lio h_nb
        dio h_run
        dac h_nb
        jmp h_ex1

// h_mch -- a character's group.
// Entry: h_mch's first word = the list entry's start word; AC = the group's character
// word, the next group after it.
// A match puts "jsp next; start" in the new list.
// Returns to the list entry after the start word.
// AC is not preserved, IO is preserved.
// Called via jda from compbuf.
h_mch,  0
        dap h_arg
        lac h_mch                       // exret, the start word (ed2.s:304-308)
        dap h_exr
        lac h_ch                        // this group's character? (ed2.s:309-312)
        sad i h_arg
        jmp h_mc1
        jmp h_mcx
h_mc1,  lac h_arg                       // "jsp next" in the new list (ed2.s:313-316)
        add u_d1
        ior h_jsp
        dac i h_np
        idx h_np
        lac i h_exr                     // and the start word (ed2.s:319-320)
        dac i h_np
        idx h_np
h_mcx,  idx h_exr                       // on along the list (ed2.s:322-323)
        jmp i h_exr

// h_fnd -- the found group.
// Entry: h_fnd's first word = the list entry's start word.
// Keeps the leftmost match, and of those the longest, as fchrno and lchrno.
// The first one makes execute skip.
// Returns to the list entry after the start word.
// AC is not preserved, IO is preserved.
// Called via jda from compbuf.
h_fnd,  0
        lac h_fnd                       // exret, the start word (ed2.s:326-330)
        dap h_exr
        lac u_fchrno
        sza
        jmp h_f1
        idx r_execute
        jmp h_f2
h_f1,   sad i h_exr
        jmp h_f3
        cma                             // an earlier start is taken (start -
        add i h_exr                     // fchrno, never 0 here; ed2.s:339-342)
        spa
        jmp h_f2
        jmp h_mcx
h_f3,   lac u_lchrno                    // from the same start, a longer match
        cma                             // is taken (charno - lchrno, -0 when
        add u_charno                    // equal, which spa reads as negative;
        spa                             // ed2.s:345-349)
        jmp h_mcx
h_f2,   lac i h_exr
        dac u_fchrno
        lac u_charno
        dac u_lchrno
        jmp h_mcx                       // ed2.s:356-357

// h_mbol -- ^'s group.
// Entry: h_mbol's first word = the list entry's start word; AC = the next group.
// At the line's first character the next group runs at once, with the same entry.
// Otherwise the list goes on.
// AC is not preserved, IO is preserved.
// Called via jda from compbuf.
h_mbol, 0
        dap h_bn
        lac u_charno
        sad u_d1
        jmp h_b1
        lac h_mbol                      // on along the list (ed2.s:363, 375-379)
        dap h_exr
        jmp h_mcx
h_b1,   lac h_mbol                      // the next group (ed2.s:366, 385-390)
h_bn,   jmp .

// h_meol -- $'s group, as ^'s, at the line's new line.
// AC is not preserved, IO is preserved.
// Called via jda from compbuf.
h_meol, 0
        dap h_en
        lac h_ch
        sad u_o12
        jmp h_e1
        lac h_meol                      // on along the list (ed2.s:373-379)
        dap h_exr
        jmp h_mcx
h_e1,   lac h_meol                      // the next group (ed2.s:383-390)
h_en,   jmp .
