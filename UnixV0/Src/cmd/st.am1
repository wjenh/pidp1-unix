x_io,   0
x_t,    0
// by hand: the display's words, from 024
h_t,    0       // temporaries
h_t2,   0
h_lim1, 0       // the first word past the room of the list being built
h_y,    0       // a planet's place on the screen, for dsplanet
h_x,    0
h_cur,  0       // 0 while list A is shown and B built, else the other way
h_cw,   0       // characters packed for the 340, three to a word
h_cn,   0       // how many are in h_cw
h_tpt,  0       // a text's pointer and count
h_tcn,  0
h_pbs,  0       // the push buttons, 1970's pbsflgs, bit n for button n
h_now,  0       // the time's low word, in sixtieths
h_tpen, 0       // when the pen last hit a button
h_pen,  0       // that button's bit
h_sup,  0       // nonzero from a reset by SS5 and SS6 until both are off
h_ytop, 01777   // the view's top row, which inscr's offsets count down from
h_xr,   01577   // the view's right column
h_y250, 0d250   // the speed line's row
h_vis,  0200000 // a visible vector; button 1's bit
h_dn,   0100000 // a vector down
h_lf,   0200    // a vector left
h_m7b,  0177    // a vector's length
h_o100, 0100
h_o37,  037     // the 340's end character
h_o777, 0777
h_m6,   077     // sense switches 1 to 6, in word 4
h_m4,   074     // switches 1 to 4
h_m17,  0377777
h_top,  07777   // the bank's last word

// updacc's early return taken as soon as the body's offset from the ship is known, before
// the squares and the sqrt, when it is above fardst (2^15) in x or in y (h_fbg), so that
// dpar would pass fardst and st2.s:190-198 return.
// It is not taken for the sun, which never returns there, nor for par or locpar, whose
// dpar is read after.
// What it skips, dpar, dtmp1, ftmp1 and the floating accumulator, is written before it is
// read for such a body.
// It is here, in the words below 0100, to keep the lists' room.
// Entry: cplan, absx and absy, after absy is stored.
// Exit: to updacc's early return (w_11010) for a far body, else back.
// AC and IO are clobbered.
// Called via jsp.
h_far,  dap h_fax
        lac u_cplan
        sza i
        jmp h_fax               // the sun
        sad u_par
        jmp h_fax
        sad u_locpar
        jmp h_fax
        lac u_absx
        lio u_absx+1
        jda h_fbg
        lac u_absy
        lio u_absy+1
        jda h_fbg
h_fax,  jmp .
0100/
        SYSFRAME()
0167/
