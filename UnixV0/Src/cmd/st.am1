// by hand: the display for the 340 in place of the GRAPHIC-2's list (st7.s:120-158).
//
// 1970 built the list in place while the display ran it.
// On the 340 a refresh that reads past the writer runs old words in the wrong mode, and an
// old word taken for a subroutine deposit would write into the kernel's banks, so each
// frame is built in a list the 340 is not running, and then given to capt.
// The parts, in memory order, are these.
//   List A, h_la, built here, filled with no-op words up to the static part, which it
//     runs into, and stopped by the gate, a halt.
//   The static part, h_stat, the frame of the view and the eight pen buttons.
//   The gate, h_gate, a no-op word while list B is shown, a halt while A is.
//   List B, from the word after the gate to the bank's top, shown from h_stat.
// Each element is written only when all its words fit (h_room), so a full list ends with
// whole elements; it ends with a halt (B) or runs into the static part (A).
//
// The texts, as 1970 kept them, one ASCII character a word, for h_text to copy into
// each frame's list in the 340's characters.
u_dispcl,0000000
w_15637,0000000                         // the word before namedsp, dispname's pointer's start
u_namedsp,
        table 012, 0
u_dssca,
        table 03, 0

// The list's words that the program builds from.
h_ppt,  parameter scale(0) lpoff next(point) 010        // a planet; its intensity ORed in
h_pcir, parameter scale(0) intensity(4) lpoff next(point)       // an arc of a circle
h_ybit, y(0) next(point)
h_nxinc, next(increment)
h_nxvec, next(vector)
h_inc1, end visible set1(incup|incright) set2(incup|incleft) set3(incdown|incleft) set4(incdown|incright)
h_hlt,  parameter halt
h_tp1,  parameter scale(1) intensity(7) lpoff next(point)       // "CL" or "L"
h_ty,   y(0d20) next(point)
h_tx1,  x(0d800) next(character)
h_tp2,  parameter intensity(4) next(point)                      // the planet's name
h_tx2,  x(0) next(character)
h_tp3,  parameter next(point)                                   // the scale
h_tx3,  x(0d400) next(character)
h_btna, h_bt0           // the first button's first word
h_pbta, h_pbt
h_pbt,  0400000         // the buttons' bits, 0 to 7
        0200000
        0100000
        040000
        020000
        010000
        04000
        02000
h_sm1,  h_stat-1        // list A's last word

// Store AC in the list's next word, at 017 + 1, as 1970's store through clistp did.
// Entry: AC = the word.
// AC and IO are preserved.
// Called via jda.
h_put,  0
        dap h_ptx
        idx 017
        lac h_put
        dac i 017
h_ptx,  jmp .

// Skip when AC words fit in the room left in the list being built.
// Entry: AC = the number of words.
// AC is clobbered, IO is preserved.
// Called via jda; skips when they fit.
h_room, 0
        dap h_rmx
        lac h_room
        add 017
        dac h_t
        lac h_lim1
        sub h_t                 // +0, no room, when the last would be the limit's word
        sma sza
        idx h_rmx
h_rmx,  jmp .

// The segment delx, dely as a visible 340 vector word, into the list.
// Entry: delx and dely.
// AC is clobbered, IO is preserved.
// Called via jda.
h_vw,   0
        dap h_vwx
        lac u_dely
        spa
        cma                     // the length
        and h_m7b
        ral 8s
        ior h_vis
        dac h_t2
        lac u_dely
        sma
        jmp h_vw1
        lac h_t2
        ior h_dn
        dac h_t2
h_vw1,  lac u_delx
        spa
        cma
        and h_m7b
        ior h_t2
        dac h_t2
        lac u_delx
        sma
        jmp h_vw2
        lac h_t2
        ior h_lf
        dac h_t2
h_vw2,  lac h_t2
        jda h_put
h_vwx,  jmp .

// An ASCII character into the list in the 340's first character set (letters of either
// case as capitals, 040 to 077 as they are), three to a word.
// Entry: AC = the character, 0 for none.
// AC is clobbered, IO is preserved.
// Called via jda.
h_ch,   0
        dap h_chx
        lac h_ch
        sza i
        jmp h_chx
        and h_o100
        sza i
        jmp h_ch1
        lac h_ch
        and h_o37
        dac h_ch
h_ch1,  lac h_cw
        ral 6s
        ior h_ch
        dac h_cw
        idx h_cn
        sad u_d3
        jmp h_ch2
h_chx,  jmp .
h_ch2,  lac h_cw
        jda h_put
        dzm h_cw
        dzm h_cn
        jmp h_chx

// The end character, and the last word of characters into the list.
// Has no arguments and no return values.
// AC is clobbered, IO is preserved.
// Called via jda.
h_che,  0
        dap h_cex
        lac h_o37
        jda h_ch
h_ce1,  lac h_cn
        sza i
        jmp h_cex
        lac h_o37               // the end again, filling the word
        jda h_ch
        jmp h_ce1
h_cex,  jmp .

// The texts at the start of the list.
// They are "CL" or "L" at 800, the planet's name at 0 and the scale at 400, on row 20,
// where 1970 put them (st7.s:120-133).
// The 340 has no blink, so "CL" and "L" are steady, at the brightest.
// At most 14 words, into a list just begun.
// Entry: dispcl, namedsp and dssca.
// AC is clobbered, IO is preserved.
// Called via jda.
h_text, 0
        dap h_txx
        lac h_tp1
        jda h_put
        lac h_ty
        jda h_put
        lac h_tx1
        jda h_put
        lac u_dispcl
        sar 9s
        jda h_ch
        lac u_dispcl
        and h_o777
        jda h_ch
        jda h_che
        lac h_tp2
        jda h_put
        lac h_tx2
        jda h_put
        law u_namedsp
        dac h_tpt
        law i 012
        dac h_tcn
h_tx4,  lac i h_tpt
        jda h_ch
        idx h_tpt
        isp h_tcn
        jmp h_tx4
        jda h_che
        lac h_tp3
        jda h_put
        lac h_tx3
        jda h_put
        law u_dssca
        dac h_tpt
        law i 03
        dac h_tcn
h_tx5,  lac i h_tpt
        jda h_ch
        idx h_tpt
        isp h_tcn
        jmp h_tx5
        jda h_che
h_txx,  jmp .

// Begin the list not shown (st1.s:69-70, where 1970 set clistp to the word before dspl).
// 017 is set to the word before it and h_lim1 past its room.
// Has no arguments and no return values.
// AC is clobbered, IO is preserved.
// Called via jda.
h_lst,  0
        dap h_lsx
        lac h_cur
        sza
        jmp h_ls1
        law h_gate              // list B, from the word after the gate
        dac 017
        lac h_top               // to the bank's top, its halt the last word
        dac h_lim1
        jmp h_lsx
h_ls1,  law h_la-1              // list A, up to the static part
        dac 017
        law h_stat
        dac h_lim1
h_lsx,  jmp .

// End the list built and show it (st1.s:141-142, 1970's halt).
// List B gets its halt and the gate is opened, and B is shown from the static part; list
// A is filled with no-op words up to the static part and the gate is shut, and A is
// shown.
// Has no arguments and no return values.
// AC and IO are clobbered (the capt system call).
// Called via jda.
h_lend, 0
        dap h_lex
        lac h_cur
        sza
        jmp h_le1
        lac h_hlt
        jda h_put
        dzm h_gate
        law h_stat
        cal SYSCAPT
        idx h_cur
        jmp h_lex
h_le1,  lac 017
        sad h_sm1
        jmp h_le2
        cla
        jda h_put
        jmp h_le1
h_le2,  lac h_hlt
        dac h_gate
        law h_la
        cal SYSCAPT
        dzm h_cur
h_lex,  jmp .

// The push buttons, 1970's pbsflgs, in h_pbs, bit n for button n, from word 4's switches
// and the pen's hits on the buttons.
// The switches SS1 to SS4 are forward, back, left and right (buttons 2 to 5), SS5 and SS6
// the scale (6 and 7), SS5 and SS6 together a reset (1), after which they do nothing until
// both are off.
// A pen hit on a button's words is taken, its bit and the time kept, and the button counts
// as held while the last hit is under 8 sixtieths old; the list is redrawn each 32 ms
// tick, so a pen held on a button hits it about every two.
// contrl takes a button's first appearance where 1970 acted once per press.
// Has no arguments; sets h_pbs, h_sup, h_now, and on a pen hit h_pen and h_tpen.
// AC and IO are clobbered.
// Called via jda.
h_rdpb, 0
        dap h_rpx
        lac 4
        and h_m6
        dac h_t
        and u_d3
        sza
        jmp h_rp0
        dzm h_sup
h_rp0,  sad u_d3
        jmp h_rp1
        lac h_sup
        sza i
        jmp h_rp2
        lac h_t
        and h_m4
        dac h_t
h_rp2,  lac h_t
        ral 9s
        ral 1s                  // switches 1 to 6 to buttons 2 to 7
        jmp h_rp3
h_rp1,  dac h_sup
        lac h_t
        and h_m4
        ral 9s
        ral 1s
        ior h_vis               // button 1, the reset
h_rp3,  dac h_pbs
        cal SYSTIME
        dio h_now
        lac 4
        sma
        jmp h_rp5               // no pen hit waiting
        and h_m17
        dac 4                   // taken
        lac 5
        sub h_btna
        spa
        jmp h_rp5               // before the buttons
        sar 2s
        dac h_t                 // four words a button
        sub u_o7                // +0 for the last button, since sub of equals is +0
        sma sza
        jmp h_rp5               // after them
        lac h_t
        add h_pbta
        dap h_rp4
h_rp4,  lac .
        dac h_pen
        lac h_now
        dac h_tpen
h_rp5,  lac h_tpen
        cma
        add h_now               // sixtieths since, +0 when equal
        spa
        jmp h_rpx
        sub u_o7
        sma sza
        jmp h_rpx               // 8 sixtieths or more
        lac h_pbs
        ior h_pen
        dac h_pbs
h_rpx,  jmp .

// For h_far, on to updacc's early return (w_11010) when a number is above fardst (2^15)
// by at least a unit of its high word.
// That is an exponent of fardst's, 16, or more, and a magnitude above fardst's high word,
// 0200000.
// Then dpar, at least that number, is above fardst by far more than the squares and the
// sqrt can lose, and fcp finds it so.
// Else back.
// Entry: AC = the number's exponent, IO = its high word.
// AC is clobbered, IO is preserved.
// Called via jda, which keeps IO (jsp would put the return in AC).
h_fbg,  0
        dap h_fbx
        lac h_fbg
        sub u_fardst            // fardst's exponent
        spa
        jmp h_fbx               // below it
        lai
        and h_m17               // the magnitude
        sub u_fardst+1          // less fardst's high word
        sma sza
        jmp w_11010             // above it
h_fbx,  jmp .

// fld and fst of the operands the hot routines use most (updacc, updpln, absxy, displa),
// each in one word, a jsp, where fop.ac's take two and about seventeen instructions.
// Each leaves AC the low word, as fld and fst do.
// AC is the low word, IO is preserved.
// Called via jsp.
h_lax,  dap h_laxx              // fld absx
        lac u_absx
        dac u_aexp
        lac u_absx+1
        dac u_ams
        lac u_absx+2
        dac u_ans
h_laxx, jmp .
h_lay,  dap h_layx              // fld absy
        lac u_absy
        dac u_aexp
        lac u_absy+1
        dac u_ams
        lac u_absy+2
        dac u_ans
h_layx, jmp .
h_lf1,  dap h_lf1x              // fld ftmp1
        lac u_ftmp1
        dac u_aexp
        lac u_ftmp1+1
        dac u_ams
        lac u_ftmp1+2
        dac u_ans
h_lf1x, jmp .
h_sax,  dap h_saxx              // fst absx
        lac u_aexp
        dac u_absx
        lac u_ams
        dac u_absx+1
        lac u_ans
        dac u_absx+2
h_saxx, jmp .
h_say,  dap h_sayx              // fst absy
        lac u_aexp
        dac u_absy
        lac u_ams
        dac u_absy+1
        lac u_ans
        dac u_absy+2
h_sayx, jmp .
h_sf1,  dap h_sf1x              // fst ftmp1
        lac u_aexp
        dac u_ftmp1
        lac u_ams
        dac u_ftmp1+1
        lac u_ans
        dac u_ftmp1+2
h_sf1x, jmp .
h_sf2,  dap h_sf2x              // fst ftmp2
        lac u_aexp
        dac u_ftmp2
        lac u_ams
        dac u_ftmp2+1
        lac u_ans
        dac u_ftmp2+2
h_sf2x, jmp .

// By hand: k = 3's constants.
// h_asc, the thrust, is 1970's ascale, which overlaps sdphi (st7.s:50), times k^2, in its
// own words since sdphi is k = 3's turn; h_thrd is 1/k.
#if ST_K != 1
h_asc,  0000003
        0617774
        0640400
h_thrd, 0777776
        0252525
        0252525
#endif

// List A's room is half of what the program leaves, so that B, from h_gate+1 to 07777
// with its halt, has as much (151 as built, B a word more).
// Set it again when the program's length changes (Src/cmd/README.md).
#if ST_K == 1
#define HLA 0d151
#else
#define HLA 0d147
#endif
h_la,
        table HLA, 0

// The static part.
// The frame of the view, 127 to 895 by 255 to 1023, with its cross at 511 and 639, and
// the speed's line at 250 below it, as st7.s:134-156 drew them, at scale 1, which draws a
// dot each 2 units.
h_stat, parameter scale(1) intensity(4) lpoff next(point)
        y(0d255) next(point)
        x(0d127) next(vector)
        visible right deltax(0d96)
        visible right deltax(0d96)
        visible right deltax(0d96)
        visible right deltax(0d96)
        visible up deltay(0d96)
        visible up deltay(0d96)
        visible up deltay(0d96)
        visible up deltay(0d96)
        visible left deltax(0d96)
        visible left deltax(0d96)
        visible left deltax(0d96)
        visible left deltax(0d96)
        visible down deltay(0d96)
        visible down deltay(0d96)
        visible down deltay(0d96)
        visible down deltay(0d96)
        right deltax(0d96)
        right deltax(0d96)
        visible up deltay(0d96)
        visible up deltay(0d96)
        visible up deltay(0d96)
        visible up deltay(0d96)
        down deltay(0d96) left deltax(0d96)
        down deltay(0d96) left deltax(0d96)
        visible right deltax(0d96)
        visible right deltax(0d96)
        visible right deltax(0d96)
        visible right deltax(0d96) end
        parameter next(point)
        y(0d250) next(point)
        x(0d127) next(vector)
        visible right deltax(0d96)
        visible right deltax(0d96)
        visible right deltax(0d96)
        visible right deltax(0d96) end
// The eight buttons on row 150, 96 apart from 127, 1970's buttons 0 to 7.
// Each is four words, a parameter word turning the pen on, the column, and two words of
// characters, which the pen hits.
        parameter scale(1) intensity(5) next(point)
        y(0d150) next(parameter)
h_bt0,  parameter lpon next(point)
        x(0d127) next(character)
        type340 "EXIT "
        parameter lpon next(point)
        x(0d223) next(character)
        type340 "RESET"
        parameter lpon next(point)
        x(0d319) next(character)
        type340 "FWD  "
        parameter lpon next(point)
        x(0d415) next(character)
        type340 "BACK "
        parameter lpon next(point)
        x(0d511) next(character)
        type340 "LEFT "
        parameter lpon next(point)
        x(0d607) next(character)
        type340 "RIGHT"
        parameter lpon next(point)
        x(0d703) next(character)
        type340 "UP   "
        parameter lpon next(point)
        x(0d799) next(character)
        type340 "DOWN "
h_gate, parameter halt          // shut, list A shown
// List B, from here to the bank's top.
x_end,
