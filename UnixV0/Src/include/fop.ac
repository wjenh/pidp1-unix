#ifdef FOP_TSIN
// sin, from a table, the sine of the accumulator within 2e-5 (the linear interpolation's
// error at most (pi/256)^2/8, 1.9e-5), where fop.s's series costs some 7,700 instructions.
// |x| below 2^-5 is its own sine (within x^3/6, 6.4e-7).
// Else u = |x| 2/pi in fixed point.
// That is the 34 bits of |x|'s magnitude above its last times 2/pi in 34 bits, the low
// digits' product left out, shifted so that u's quadrant is in AC's 0600 bits, its next 7
// bits, the table's index i, in AC's 0177 and the 18 bits below in IO, of which the top 17
// are r, the place between entries i and i + 1.
// An odd quadrant takes u's fraction turned (i and r complemented, 2^-24 of a quadrant
// short of 1 - fraction), the third and fourth the sign turned.
// Then N = S[i] + (S[i+1] - S[i]) r / 2^17, the product truncated, in units of 2^-23,
// normalized into the accumulator.
// Above 2^10 the reduction keeps fewer of u's bits below the point, 2^(k-34) at 2^k, and
// from 2^37 the result is 0, bounded where fop.s's grows without bound.
// AC and IO are clobbered.
// Called via jda.
u_sin,  0
        dap r_sin
        lac u_ams
        and f_sgn
        dac f_sgw
        xor u_ams
        dac u_ams               // Mh, |x|'s top 17 bits
        lac u_aexp
        spa
        sub f_tm5               // a negative aexp plus 5, -5 giving +0
        spa
        jmp f_tsx               // aexp -6 or less, x itself
        lac u_ans
        sar 1s
        and f_m17
        dac f_tml               // Ml, the low word's top 17 bits
        lac u_ams
        mul f_tcl
        dac f_q1                // Mh * Cl, its high digit
        lai
        rar 1s
        dac f_q2                // and its low
        lac f_tml
        mul f_tch
        dac f_q3                // Ml * Ch, its high digit
        lai
        rar 1s
        add f_q2                // the two low digits, below 0777777
        and f_sgn
        sza
        lac f_one
        dac f_t                 // their carry
        lac u_ams
        mul f_tch
        dac f_l2                // Mh * Ch, D2, the product's bits 51 up
        lai
        rar 1s
        dac f_l1                // D1, its bits 34 to 50
        F_ADDC(f_l1, f_l2, f_q1)
        F_ADDC(f_l1, f_l2, f_q3)
        F_ADDC(f_l1, f_l2, f_t)
        lac f_l1
        ral 1s
        dac f_t
        lio f_t                 // AC:IO will be D2:D1, times 2
        lac f_d10
        sub u_aexp              // k = 10 - aexp
        spa
        jmp f_tl
        dac f_k
        lac f_l2
        dac f_x
        jsp f_srk               // AC:IO down k places
f_tw,   dac f_x                 // the quadrant and i
        lai
        sar 1s
        and f_m17
        dac f_tr                // r
        lac f_x
        and f_t177
        dac f_ti                // i
        lac f_x
        and f_t200
        sza i
        jmp f_te
        lac f_ti                // an odd quadrant, the fraction turned
        xor f_t177
        dac f_ti
        lac f_tr
        xor f_m17
        dac f_tr
f_te,   lac f_x
        and f_t400
        sza
        lac f_sgn               // the third and fourth quadrants, negative
        xor f_sgw
        dac f_sgw
        lac f_ti
        ral 1s
        add f_tba
        dap f_ta0               // S[i]'s high digit
        add f_one
        dap f_ta1               // its low
        dap f_ta2
        add f_two
        dap f_ta3               // S[i+1]'s low
f_ta0,  lac .
        dac f_l2
f_ta1,  lac .
        dac f_l1
f_ta3,  lac .
f_ta2,  sub .                   // S[i+1] - S[i] below 2^17, the low digits' difference,
        sma
        jmp f_td
        and f_m17               // or, negative, that plus 2^17
        add f_one
f_td,   mul f_tr
        dac f_t                 // the difference times r / 2^17
        F_ADDC(f_l1, f_l2, f_t)
        lac f_l1
        ral 1s
        dac f_t
        lio f_t
        lac f_l2
        rcl 9s
        rcl 1s                  // AC:IO = N * 2^11
        dac u_ams
        dio u_ans
        lac f_one
        dac u_aexp              // the value N * 2^-23
        jsp f_nrm
        lac u_ams
        sza i
        jmp r_sin               // zero, no sign
f_tsx,  lac u_ams
        xor f_sgw
        dac u_ams
r_sin,  jmp .

// aexp above 10, AC:IO up s = aexp - 10 places, at most 27.
// At 27 the 27 bits used are 0.
f_tl,   cma
        sub f_d27
        sma
        cla
        add f_d27
        dac f_kk                // s
        lac f_l2
f_tl1,  scl 1s
        dac f_x
        lac f_kk
        sub f_one
        dac f_kk
        sza i
        jmp f_tl2
        lac f_x
        jmp f_tl1
f_tl2,  lac f_x
        jmp f_tw

f_sgw,  0
f_tml,  0
f_ti,   0
f_tr,   0
